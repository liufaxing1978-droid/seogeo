<%
  const keywordById = new Map(keywordCenter.keywords.map((item) => [item.id, item]));
  const keywordOptionById = new Map(keywordCenter.keywordOptions.map((item) => [item.id, item]));
  const groupById = new Map(keywordCenter.groups.map((item) => [item.id, item]));
  const typeLabels = {
    CORE: '核心词',
    LONG_TAIL: '长尾词',
    BRAND: '品牌词',
    QUESTION: '问题词',
    LOCAL: '地域词',
    COMMERCIAL: '商业词',
  };
  const intentLabels = {
    INFORMATIONAL: '信息型',
    NAVIGATIONAL: '导航型',
    COMMERCIAL_INVESTIGATION: '商业调研',
    TRANSACTIONAL: '交易型',
    LOCAL: '本地型',
    UNKNOWN: '未分类',
  };
  const coverageLabels = {
    STRONG: '强覆盖',
    PARTIAL: '部分覆盖',
    NONE: '未覆盖',
    UNKNOWN: '证据不足',
  };
  const searchProviderLabels = {
    GOOGLE_SEARCH_CONSOLE: 'Google Search Console',
    BING_WEBMASTER: 'Bing Webmaster Tools',
  };
  const searchEvidenceStateLabels = {
    OBSERVED: '已观察',
    NOT_OBSERVED: '未观察',
    UNKNOWN: '证据不足',
    UNAVAILABLE: '不可用',
  };
  const statusLabels = { ACTIVE: '启用', DISABLED: '停用', ARCHIVED: '已归档' };
  const lifecycleLabels = {
    DISCOVERED: '已发现', EVALUATING: '评估中', APPROVED: '已批准', MAPPED: '已映射',
    CONTENT_PLANNED: '内容已规划', CONTENT_IN_PROGRESS: '内容制作中', PUBLISHED: '已发布',
    INDEXED: '已收录', RANKING: '已有排名', AI_CITED: 'AI 已引用',
    NEEDS_OPTIMIZATION: '待优化', RETIRED: '已淘汰',
  };
  const opportunityComponentLabels = {
    relevance: '项目相关度', demand: '搜索需求', rankingOpportunity: '排名机会',
    difficulty: '竞争难度', contentGap: '内容缺口', authorityFit: '权威匹配',
    strategicValue: '战略价值', geoValue: 'GEO 价值',
  };
  const opportunityBand = (score) => score === null ? '证据不足'
    : score >= 90 ? '强烈建议' : score >= 75 ? '建议' : score >= 50 ? '观察' : '低优先级';
  const suggestionStatusLabels = {
    PENDING: '待审核',
    ACCEPTED: '已接受',
    REJECTED: '已拒绝',
    EXPIRED: '已过期',
  };
%>

<section class="keyword-center" data-ui="keyword-center">
  <header class="keyword-center__hero">
    <div>
      <p class="keyword-center__eyebrow">Search Demand Capture</p>
      <h2>关键词中心</h2>
      <p>管理核心关键词与长尾关键词，并用站内已持久化页面事实检查内容覆盖。实时当前排名数据仍未接入；下方搜索证据只展示已持久化的官方平台观测事实。</p>
    </div>
    <div class="keyword-center__rank-note" data-ui="keyword-ranking-status">
      <span>搜索排名</span>
      <strong>排名数据：未接入</strong>
    </div>
  </header>

  <section class="keyword-summary" aria-label="需求概览">
    <article class="keyword-summary__card"><span>启用关键词</span><strong><%= keywordCenter.summary.active %></strong></article>
    <article class="keyword-summary__card"><span>战略锁定</span><strong><%= keywordCenter.summary.locked %></strong></article>
    <article class="keyword-summary__card keyword-summary__card--strong"><span>强覆盖</span><strong><%= keywordCenter.summary.strong %></strong></article>
    <article class="keyword-summary__card keyword-summary__card--partial"><span>部分覆盖</span><strong><%= keywordCenter.summary.partial %></strong></article>
    <article class="keyword-summary__card"><span>未覆盖</span><strong><%= keywordCenter.summary.none %></strong></article>
    <article class="keyword-summary__card"><span>证据不足</span><strong><%= keywordCenter.summary.unknown %></strong></article>
  </section>

  <section class="keyword-panel" data-ui="keyword-filter-panel">
    <div class="keyword-panel__heading">
      <div><p class="keyword-panel__kicker">Workbench Filters</p><h3>筛选关键词</h3></div>
      <p>筛选由服务端执行，所有条件保持项目隔离。</p>
    </div>
    <form class="keyword-create-form" method="get" action="/projects/<%= keywordCenter.project.id %>/keywords">
      <label class="keyword-field keyword-field--wide"><span>筛选文本</span><input name="q" value="<%= keywordCenter.filters.q || '' %>" placeholder="关键词"></label>
      <label class="keyword-field"><span>词类筛选</span><select name="type"><option value="">全部</option><% Object.entries(typeLabels).forEach(([value, label]) => { %><option value="<%= value %>" <%= keywordCenter.filters.type === value ? 'selected' : '' %>><%= label %></option><% }) %></select></label>
      <label class="keyword-field"><span>筛选 Intent</span><select name="intent"><option value="">全部</option><% Object.entries(intentLabels).forEach(([value, label]) => { %><option value="<%= value %>" <%= keywordCenter.filters.intent === value ? 'selected' : '' %>><%= label %></option><% }) %></select></label>
      <label class="keyword-field"><span>筛选生命周期</span><select name="lifecycleStatus"><option value="">全部</option><% Object.entries(lifecycleLabels).forEach(([value, label]) => { %><option value="<%= value %>" <%= keywordCenter.filters.lifecycleStatus === value ? 'selected' : '' %>><%= label %></option><% }) %></select></label>
      <label class="keyword-field"><span>筛选 Cluster</span><select name="groupId"><option value="">全部</option><% keywordCenter.groups.forEach((group) => { %><option value="<%= group.id %>" <%= keywordCenter.filters.groupId === group.id ? 'selected' : '' %>><%= group.name %></option><% }) %></select></label>
      <button class="keyword-button keyword-button--primary" type="submit">应用筛选</button>
      <a class="keyword-button" href="/projects/<%= keywordCenter.project.id %>/keywords">清除</a>
    </form>
  </section>

  <% if (canWriteKeywords) { %>
    <section class="keyword-panel keyword-panel--create" data-ui="keyword-create-panel">
      <div class="keyword-panel__heading">
        <div>
          <p class="keyword-panel__kicker">手动关键词</p>
          <h3>添加关键词</h3>
        </div>
        <p>手动输入始终是主入口；AI 建议只能作为候选，不会自动写入关键词库。</p>
      </div>
      <form class="keyword-create-form" data-ui="keyword-create-form" method="post" action="/projects/<%= keywordCenter.project.id %>/keywords">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label class="keyword-field keyword-field--wide">
          <span>关键词</span>
          <input name="text" type="text" required maxlength="240" placeholder="例如：符纸">
        </label>
        <label class="keyword-field">
          <span>类型</span>
          <select name="type" required>
            <option value="CORE">核心词</option>
            <option value="LONG_TAIL">长尾词</option>
            <option value="BRAND">品牌词</option>
            <option value="QUESTION">问题词</option>
            <option value="LOCAL">地域词</option>
            <option value="COMMERCIAL">商业词</option>
          </select>
        </label>
        <label class="keyword-field">
          <span>搜索意图</span>
          <select name="intent">
            <option value="">未分类</option>
            <option value="INFORMATIONAL">信息型</option>
            <option value="NAVIGATIONAL">导航型</option>
            <option value="COMMERCIAL_INVESTIGATION">商业调研</option>
            <option value="TRANSACTIONAL">交易型</option>
            <option value="LOCAL">本地型</option>
            <option value="UNKNOWN">未知</option>
          </select>
        </label>
        <label class="keyword-field">
          <span>优先级</span>
          <select name="priority">
            <option value="HIGH">高</option>
            <option value="MEDIUM" selected>中</option>
            <option value="LOW">低</option>
          </select>
        </label>
        <label class="keyword-field"><span>生命周期</span><select name="lifecycleStatus"><option value="DISCOVERED" selected>已发现</option><option value="EVALUATING">评估中</option><option value="APPROVED">已批准</option></select></label>
        <label class="keyword-field">
          <span>父词</span>
          <select name="parentKeywordId">
            <option value="">无</option>
            <% keywordCenter.keywords.filter((item) => item.status !== 'ARCHIVED').forEach((item) => { %>
              <option value="<%= item.id %>"><%= item.text %></option>
            <% }) %>
          </select>
        </label>
        <label class="keyword-check">
          <input type="checkbox" name="locked" value="true">
          <span>战略锁定</span>
        </label>
        <button class="keyword-button keyword-button--primary" type="submit">添加关键词</button>
      </form>
      <form class="keyword-create-form" data-ui="keyword-bulk-create-form" method="post" action="/projects/<%= keywordCenter.project.id %>/keywords/bulk">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label class="keyword-field keyword-field--wide"><span>批量添加（每行一个，最多 100 个）</span><textarea name="text" rows="5" required maxlength="30000" placeholder="符纸&#10;六壬法教&#10;民间信仰"></textarea></label>
        <label class="keyword-field"><span>批量词类</span><select name="type" required><option value="CORE">核心词</option><option value="LONG_TAIL">长尾词</option><option value="BRAND">品牌词</option><option value="QUESTION">问题词</option><option value="LOCAL">地域词</option><option value="COMMERCIAL">商业词</option></select></label>
        <label class="keyword-field"><span>批量等级</span><select name="priority"><option value="HIGH">高</option><option value="MEDIUM" selected>中</option><option value="LOW">低</option></select></label>
        <input type="hidden" name="lifecycleStatus" value="DISCOVERED">
        <button class="keyword-button keyword-button--primary" type="submit">批量添加</button>
      </form>
    </section>
  <% } %>

  <section class="keyword-panel" data-ui="keyword-coverage-panel">
    <div class="keyword-panel__heading">
      <div>
        <p class="keyword-panel__kicker">Coverage Facts</p>
        <h3>站内内容覆盖</h3>
      </div>
      <p>仅使用最新持久化抓取快照中的标题、H1、Meta Description 与 URL path；不会为了查看本页主动发起抓取。</p>
    </div>

    <% if (keywordCenter.keywords.length === 0) { %>
      <div class="keyword-empty">尚未添加关键词。先建立核心词，再逐步补充长尾词和问题词。</div>
    <% } else { %>
      <div class="keyword-table-wrap" data-ui="keyword-library">
        <table class="keyword-table">
          <thead>
            <tr>
              <th>关键词</th>
              <th>类型 / 意图</th>
              <th>优先级</th>
              <th>机会分</th>
              <th>Target URL</th>
              <th>Cannibalization</th>
              <th>内容覆盖</th>
              <th>搜索证据</th>
              <th>父关键词 / 分组</th>
              <th>状态</th>
              <th>生命周期</th>
              <% if (canWriteKeywords) { %><th>操作</th><% } %>
            </tr>
          </thead>
          <tbody>
            <% keywordCenter.keywords.forEach((keyword) => {
              const parent = keyword.parentKeywordId ? keywordById.get(keyword.parentKeywordId) : null;
              const keywordGroups = keyword.groupIds.map((id) => groupById.get(id)).filter(Boolean);
              const topMatch = keyword.coverage.matches[0];
            %>
              <tr data-ui="keyword-row" data-keyword-id="<%= keyword.id %>">
                <td>
                  <div class="keyword-name">
                    <strong><%= keyword.text %></strong>
                    <span><%= keyword.source === 'MANUAL' ? '手动' : 'AI 已接受' %></span>
                    <% if (keyword.locked) { %><span class="keyword-lock">已锁定</span><% } %>
                  </div>
                </td>
                <td data-ui="keyword-target-url"><%= keyword.targetUrl || '未映射' %></td>
                <td data-ui="keyword-cannibalization">
                  <% if (keyword.cannibalization) { %>
                    <strong><%= keyword.cannibalization.risk %></strong>
                    <small><%= keyword.cannibalization.recommendedAction || '无需动作' %> · 置信度 <%= keyword.cannibalization.confidence === null ? '未知' : Math.round(keyword.cannibalization.confidence * 100) + '%' %></small>
                  <% } else { %>
                    <span>未分析</span>
                  <% } %>
                </td>
                <td>
                  <div class="keyword-meta-stack">
                    <span><%= typeLabels[keyword.type] || keyword.type %></span>
                    <small><%= keyword.intent ? (intentLabels[keyword.intent] || keyword.intent) : '未分类' %></small>
                  </div>
                </td>
                <td><span class="keyword-priority keyword-priority--<%= keyword.priority.toLowerCase() %>"><%= keyword.priority === 'HIGH' ? '高' : keyword.priority === 'LOW' ? '低' : '中' %></span></td>
                <td>
                  <div class="keyword-opportunity" data-ui="keyword-opportunity-score">
                    <% if (keyword.opportunity) { %>
                      <div class="keyword-opportunity__summary">
                        <strong><%= keyword.opportunity.score === null ? 'N/A' : keyword.opportunity.score.toFixed(1) %></strong>
                        <span><%= opportunityBand(keyword.opportunity.score) %></span>
                        <small>置信度 <%= Math.round(keyword.opportunity.dataConfidence * 100) %>%</small>
                      </div>
                      <details class="keyword-opportunity__details">
                        <summary>评分依据</summary>
                        <dl><% Object.entries(keyword.opportunity.breakdown).forEach(([component, entry]) => { %><div><dt><%= opportunityComponentLabels[component] || component %></dt><dd><%= entry.state === 'KNOWN' ? entry.score.toFixed(1) : '证据不足' %> · 权重 <%= entry.weight %>%</dd></div><% }) %></dl>
                      </details>
                    <% } else { %>
                      <span class="keyword-opportunity__empty">未评分</span>
                    <% } %>
                    <% if (canWriteKeywords) { %>
                      <form method="post" action="/projects/<%= keywordCenter.project.id %>/keywords/<%= keyword.id %>/opportunity-score">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button class="keyword-button" type="submit"><%= keyword.opportunity ? '重新评分' : '计算机会分' %></button>
                      </form>
                    <% } %>
                  </div>
                </td>
                <td>
                  <div class="keyword-coverage keyword-coverage--<%= keyword.coverage.status.toLowerCase() %>" data-ui="keyword-coverage">
                    <strong><%= coverageLabels[keyword.coverage.status] %></strong>
                    <% if (topMatch) { %>
                      <a href="<%= topMatch.url %>" target="_blank" rel="noreferrer"><%= topMatch.url %></a>
                      <small>证据分 <%= topMatch.score %> · 标题 <%= topMatch.titleMatch ? '✓' : '—' %> · H1 <%= topMatch.h1Match ? '✓' : '—' %></small>
                    <% } else { %>
                      <small><%= keyword.coverage.reason === 'NO_ACTIVE_PAGE_EVIDENCE' ? '暂无启用页面证据' : keyword.coverage.reason === 'NO_USABLE_SNAPSHOT_EVIDENCE' ? '暂无可用抓取快照' : '已有页面证据，但未发现匹配' %></small>
                    <% } %>
                  </div>
                </td>
                <td>
                  <div class="keyword-search-evidence" data-ui="keyword-search-evidence">
                    <small class="keyword-search-evidence__window">证据窗口 <%= keyword.searchEvidence.dateFrom %> – <%= keyword.searchEvidence.dateTo %></small>
                    <% keyword.searchEvidence.evidence.forEach((evidence) => { %>
                      <article class="keyword-search-evidence__item keyword-search-evidence__item--<%= evidence.state.toLowerCase().replace('_', '-') %>" data-provider="<%= evidence.provider %>">
                        <div class="keyword-search-evidence__head">
                          <strong class="keyword-search-evidence__provider"><%= searchProviderLabels[evidence.provider] || evidence.provider %></strong>
                          <span class="keyword-search-evidence__state"><%= searchEvidenceStateLabels[evidence.state] || evidence.state %></span>
                        </div>
                        <% if (evidence.kind === 'LANE') { %>
                          <small class="keyword-search-evidence__source"><%= evidence.marketCode %> · <%= evidence.locale %> · <%= evidence.propertyRef %></small>
                        <% } %>

                        <% if (evidence.state === 'OBSERVED') { %>
                          <div class="keyword-search-evidence__metrics">
                            <% if (evidence.metrics.clicks !== null) { %><span>点击 <strong><%= evidence.metrics.clicks %></strong></span><% } %>
                            <% if (evidence.metrics.impressions !== null) { %><span>展示 <strong><%= evidence.metrics.impressions %></strong></span><% } %>
                            <% if (evidence.metrics.ctr !== null) { %><span>CTR <strong><%= (evidence.metrics.ctr * 100).toFixed(2) %>%</strong></span><% } %>
                            <% if (evidence.metrics.searchConsoleAveragePosition !== null) { %><span>Search Console 平均位置 <strong><%= evidence.metrics.searchConsoleAveragePosition.toFixed(2) %></strong></span><% } %>
                            <% if (evidence.metrics.bingAverageClickPosition !== null) { %><span>Bing 平均点击位置 <strong><%= evidence.metrics.bingAverageClickPosition.toFixed(2) %></strong></span><% } %>
                            <% if (evidence.metrics.bingAverageImpressionPosition !== null) { %><span>Bing 平均展示位置 <strong><%= evidence.metrics.bingAverageImpressionPosition.toFixed(2) %></strong></span><% } %>
                          </div>
                          <% if (evidence.latestSourceDate) { %><small class="keyword-search-evidence__source">最新匹配证据 <%= evidence.latestSourceDate %></small><% } %>
                        <% } else if (evidence.state === 'UNKNOWN' && evidence.kind === 'LANE') { %>
                          <p class="keyword-search-evidence__truth">当前持久化数据不完整，未观察到该关键词不能解释为 0 搜索量或无排名。</p>
                        <% } else if (evidence.state === 'UNKNOWN') { %>
                          <p class="keyword-search-evidence__truth">当前没有已持久化的查询级证据，不能据此推断搜索量或排名。</p>
                        <% } else if (evidence.state === 'NOT_OBSERVED') { %>
                          <p class="keyword-search-evidence__truth">完整持久化查询证据中未观察到该关键词；这只表示当前证据窗口内未匹配。</p>
                        <% } else if (evidence.state === 'UNAVAILABLE') { %>
                          <p class="keyword-search-evidence__truth">官方平台能力尚未接入 / 当前接口不支持查询级证据</p>
                        <% } %>
                      </article>
                    <% }) %>
                  </div>
                </td>
                <td>
                  <div class="keyword-meta-stack">
                    <span>父词：<%= parent ? parent.text : '—' %></span>
                    <small>分组：<%= keywordGroups.length ? keywordGroups.map((group) => group.name).join('、') : '—' %></small>
                  </div>
                </td>
                <td><span class="keyword-status keyword-status--<%= keyword.status.toLowerCase() %>"><%= statusLabels[keyword.status] %></span></td>
                <td><span class="keyword-status"><%= lifecycleLabels[keyword.lifecycleStatus] || keyword.lifecycleStatus %></span></td>
                <% if (canWriteKeywords) { %>
                  <td>
                    <details class="keyword-actions">
                      <summary>管理</summary>
                      <div class="keyword-actions__body">
                        <% if (keyword.status !== 'ARCHIVED') { %>
                          <form method="post" action="/projects/<%= keywordCenter.project.id %>/keywords/<%= keyword.id %>/update">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <% if (keyword.locked) { %><input type="hidden" name="acknowledgeLock" value="true"><% } %>
                            <label><span>关键词</span><input name="text" value="<%= keyword.text %>" required></label>
                            <label><span>类型</span>
                              <select name="type">
                                <% Object.entries(typeLabels).forEach(([value, label]) => { %>
                                  <option value="<%= value %>" <%= keyword.type === value ? 'selected' : '' %>><%= label %></option>
                                <% }) %>
                              </select>
                            </label>
                            <label><span>意图</span>
                              <select name="intent">
                                <option value="" <%= !keyword.intent ? 'selected' : '' %>>未分类</option>
                                <% Object.entries(intentLabels).forEach(([value, label]) => { %>
                                  <option value="<%= value %>" <%= keyword.intent === value ? 'selected' : '' %>><%= label %></option>
                                <% }) %>
                              </select>
                            </label>
                            <label><span>优先级</span>
                              <select name="priority">
                                <option value="HIGH" <%= keyword.priority === 'HIGH' ? 'selected' : '' %>>高</option>
                                <option value="MEDIUM" <%= keyword.priority === 'MEDIUM' ? 'selected' : '' %>>中</option>
                                <option value="LOW" <%= keyword.priority === 'LOW' ? 'selected' : '' %>>低</option>
                              </select>
                            </label>
                            <label><span>生命周期</span><select name="lifecycleStatus"><% Object.entries(lifecycleLabels).forEach(([value, label]) => { %><option value="<%= value %>" <%= keyword.lifecycleStatus === value ? 'selected' : '' %>><%= label %></option><% }) %></select></label>
                            <button class="keyword-button" type="submit">保存编辑</button>
                          </form>

                          <form method="post" action="/projects/<%= keywordCenter.project.id %>/keywords/<%= keyword.id %>/lock">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <input type="hidden" name="locked" value="<%= keyword.locked ? 'false' : 'true' %>">
                            <% if (keyword.locked) { %><input type="hidden" name="acknowledgeLock" value="true"><% } %>
                            <button class="keyword-button" type="submit"><%= keyword.locked ? '解除锁定' : '战略锁定' %></button>
                          </form>

                          <form method="post" action="/projects/<%= keywordCenter.project.id %>/keywords/<%= keyword.id %>/parent">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <% if (keyword.locked) { %><input type="hidden" name="acknowledgeLock" value="true"><% } %>
                            <label><span>设置父词</span>
                              <select name="parentKeywordId" required>
                                <option value="">选择父词</option>
                                <% keywordCenter.keywords.filter((item) => item.id !== keyword.id && item.status !== 'ARCHIVED').forEach((item) => { %>
                                  <option value="<%= item.id %>" <%= keyword.parentKeywordId === item.id ? 'selected' : '' %>><%= item.text %></option>
                                <% }) %>
                              </select>
                            </label>
                            <button class="keyword-button" type="submit">设置父词</button>
                          </form>

                          <% if (keyword.parentKeywordId) { %>
                            <form method="post" action="/projects/<%= keywordCenter.project.id %>/keywords/<%= keyword.id %>/parent/remove">
                              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                              <% if (keyword.locked) { %><input type="hidden" name="acknowledgeLock" value="true"><% } %>
                              <button class="keyword-button" type="submit">移除父词</button>
                            </form>
                          <% } %>

                          <form method="post" action="/projects/<%= keywordCenter.project.id %>/keywords/<%= keyword.id %>/groups">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <% if (keyword.locked) { %><input type="hidden" name="acknowledgeLock" value="true"><% } %>
                            <fieldset>
                              <legend>关键词分组</legend>
                              <% if (!keywordCenter.groups.length) { %><small>尚无分组</small><% } %>
                              <% keywordCenter.groups.forEach((group) => { %>
                                <label class="keyword-check"><input type="checkbox" name="groupIds" value="<%= group.id %>" <%= keyword.groupIds.includes(group.id) ? 'checked' : '' %>><span><%= group.name %></span></label>
                              <% }) %>
                            </fieldset>
                            <button class="keyword-button" type="submit">保存分组</button>
                          </form>

                          <form method="post" action="/projects/<%= keywordCenter.project.id %>/keywords/<%= keyword.id %>/archive">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <% if (keyword.locked) { %><input type="hidden" name="acknowledgeLock" value="true"><% } %>
                            <button class="keyword-button keyword-button--danger" type="submit">归档</button>
                          </form>
                        <% } else { %>
                          <form method="post" action="/projects/<%= keywordCenter.project.id %>/keywords/<%= keyword.id %>/restore">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <% if (keyword.locked) { %><input type="hidden" name="acknowledgeLock" value="true"><% } %>
                            <button class="keyword-button" type="submit">恢复关键词</button>
                          </form>
                        <% } %>
                      </div>
                    </details>
                  </td>
                <% } %>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </section>

  <div class="keyword-center__lower-grid">
    <section class="keyword-panel" data-ui="keyword-cluster-panel">
      <div class="keyword-panel__heading">
        <div><p class="keyword-panel__kicker">Keyword Cluster</p><h3>关键词 Cluster</h3></div>
      </div>
      <% if (keywordCenter.groups.length) { %>
        <div class="keyword-cluster-list">
          <% keywordCenter.groups.forEach((group) => {
            const primaryKeyword = group.primaryKeywordId ? keywordOptionById.get(group.primaryKeywordId) : null;
          %>
            <article class="keyword-cluster-card" data-cluster-id="<%= group.id %>">
              <div class="keyword-cluster-card__heading">
                <strong><%= group.name %></strong>
                <span>主词：<%= primaryKeyword ? primaryKeyword.text : '未设置' %></span>
              </div>
              <% if (canWriteKeywords) { %>
                <form class="keyword-inline-form" method="post" action="/projects/<%= keywordCenter.project.id %>/keyword-groups/<%= group.id %>/rename">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <label class="keyword-field"><span>Cluster 名称</span><input name="name" value="<%= group.name %>" required maxlength="160"></label>
                  <button class="keyword-button" type="submit">重命名</button>
                </form>
                <form class="keyword-inline-form" method="post" action="/projects/<%= keywordCenter.project.id %>/keyword-groups/<%= group.id %>/primary-keyword">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <label class="keyword-field"><span>主词</span><select name="primaryKeywordId"><option value="">未设置</option><% keywordCenter.keywordOptions.filter((item) => item.status !== 'ARCHIVED').forEach((item) => { %><option value="<%= item.id %>" <%= group.primaryKeywordId === item.id ? 'selected' : '' %>><%= item.text %></option><% }) %></select></label>
                  <button class="keyword-button" type="submit">设置主词</button>
                </form>
                <form class="keyword-cluster-assignment" method="post" action="/projects/<%= keywordCenter.project.id %>/keyword-groups/<%= group.id %>/keywords">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <fieldset><legend>批量加入成员词</legend><div class="keyword-chip-list"><% keywordCenter.keywordOptions.filter((item) => item.status !== 'ARCHIVED').forEach((item) => { %><label class="keyword-check"><input type="checkbox" name="keywordIds" value="<%= item.id %>"><span><%= item.text %></span></label><% }) %></div></fieldset>
                  <label class="keyword-check"><input type="checkbox" name="acknowledgeLock" value="true"><span>确认调整锁定词</span></label>
                  <button class="keyword-button" type="submit">批量加入</button>
                </form>
              <% } %>
            </article>
          <% }) %>
        </div>
      <% } else { %>
        <p class="keyword-empty keyword-empty--compact">尚未建立 Keyword Cluster。</p>
      <% } %>
      <% if (canWriteKeywords) { %>
        <form class="keyword-inline-form" method="post" action="/projects/<%= keywordCenter.project.id %>/keyword-groups">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <label class="keyword-field"><span>新 Cluster</span><input name="name" required placeholder="例如：符纸专题"></label>
          <button class="keyword-button" type="submit">创建 Cluster</button>
        </form>
      <% } %>
    </section>

    <section class="keyword-panel keyword-panel--advisory" data-ui="keyword-advisory-panel">
      <div class="keyword-panel__heading">
        <div>
          <p class="keyword-panel__kicker">Advisory · AI 仅供建议</p>
          <h3>AI 长尾建议</h3>
        </div>
        <span class="keyword-advisory-badge">人工审核后生效</span>
      </div>
      <p class="keyword-advisory-copy">DeepSeek 只生成候选建议，不会自动写入关键词库。只有具备内容写入权限的人员明确点击“接受并加入词库”后，候选词才成为正式关键词。</p>

      <% if (canRunKeywordAi) { %>
        <div class="keyword-advisory-seeds" aria-label="生成长尾建议">
          <% const expansionSeeds = keywordCenter.keywords.filter((item) => item.status !== 'ARCHIVED'); %>
          <% if (!expansionSeeds.length) { %>
            <p class="keyword-empty keyword-empty--compact">先添加一个关键词，再生成长尾建议。</p>
          <% } else { %>
            <% expansionSeeds.forEach((keyword) => { %>
              <form data-ui="keyword-suggestion-generate" method="post" action="/projects/<%= keywordCenter.project.id %>/keywords/<%= keyword.id %>/suggestions/generate">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button class="keyword-button" type="submit">为「<%= keyword.text %>」生成建议</button>
              </form>
            <% }) %>
          <% } %>
        </div>
      <% } %>

      <% if (!keywordCenter.suggestions.length) { %>
        <p class="keyword-empty keyword-empty--compact">暂无 AI 建议。建议不会自动创建、发布或修改关键词。</p>
      <% } else { %>
        <div class="keyword-suggestion-list">
          <% keywordCenter.suggestions.forEach((suggestion) => {
            const seedKeyword = keywordById.get(suggestion.seedKeywordId);
          %>
            <article class="keyword-suggestion-card keyword-suggestion-card--<%= suggestion.status.toLowerCase() %>" data-suggestion-id="<%= suggestion.id %>">
              <div class="keyword-suggestion-card__head">
                <div>
                  <strong><%= suggestion.suggestedText %></strong>
                  <small>来源核心词：<%= seedKeyword ? seedKeyword.text : '—' %></small>
                </div>
                <span class="keyword-suggestion-status"><%= suggestionStatusLabels[suggestion.status] || suggestion.status %></span>
              </div>
              <p><%= suggestion.rationale || '未提供理由' %></p>

              <% if (suggestion.status === 'PENDING' && canWriteKeywords) { %>
                <div class="keyword-suggestion-actions">
                  <form data-ui="keyword-suggestion-accept" method="post" action="/projects/<%= keywordCenter.project.id %>/keyword-suggestions/<%= suggestion.id %>/accept">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <label class="keyword-field">
                      <span>接受前可编辑</span>
                      <input name="editedText" value="<%= suggestion.suggestedText %>" required maxlength="240">
                    </label>
                    <button class="keyword-button keyword-button--primary" type="submit">接受并加入词库</button>
                  </form>
                  <form data-ui="keyword-suggestion-reject" method="post" action="/projects/<%= keywordCenter.project.id %>/keyword-suggestions/<%= suggestion.id %>/reject">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button class="keyword-button keyword-button--danger" type="submit">拒绝</button>
                  </form>
                </div>
              <% } %>
            </article>
          <% }) %>
        </div>
      <% } %>
    </section>
  </div>
</section>
