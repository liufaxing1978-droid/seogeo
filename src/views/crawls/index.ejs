<section class="page-heading">
  <div>
    <p class="eyebrow">Crawler</p>
    <h2>抓取历史</h2>
    <p class="muted"><%= project.name %> · <%= project.primaryDomain %></p>
  </div>
  <div class="actions">
    <a class="button secondary" href="/projects/<%= project.id %>/pages">页面中心</a>
    <a class="button secondary" href="/projects/<%= project.id %>">项目详情</a>
  </div>
</section>

<section class="panel">
  <div class="panel-header">
    <div>
      <h3>Crawler Health</h3>
      <p>基于已完成抓取的持久化事实；查看此页面不会启动新的抓取。</p>
    </div>
  </div>
  <% if (latestHealth) { %>
    <dl class="detail-grid">
      <div><dt>状态</dt><dd><span class="badge <%= latestHealth.status === 'HEALTHY' ? 'success' : latestHealth.status === 'FAILED' ? 'danger' : 'neutral' %>"><%= latestHealth.status %></span></dd></div>
      <div><dt>抓取记录</dt><dd><a class="link-primary" href="/crawls/<%= latestHealth.crawlRunId %>"><%= latestHealth.crawlRunId %></a></dd></div>
      <div><dt>计算版本</dt><dd><%= latestHealth.calculationVersion %></dd></div>
      <div><dt>生成时间</dt><dd><%= latestHealth.createdAt.toLocaleString('zh-CN') %></dd></div>
    </dl>
  <% } else { %>
    <p class="muted">尚无已持久化的 crawler-health 快照。</p>
  <% } %>
</section>

<section class="panel table-panel">
  <div class="panel-header">
    <div>
      <h3>IndexNow 提交历史</h3>
      <p>提交已接受不代表已收录、已抓取、已排名或已发布。</p>
    </div>
  </div>
  <% if (!submissions.length) { %>
    <p class="muted">尚无 IndexNow 提交记录。</p>
  <% } else { %>
    <div class="table-wrap">
      <table>
        <thead><tr><th>状态</th><th>URL 数</th><th>尝试</th><th>HTTP</th><th>错误</th><th>创建时间</th></tr></thead>
        <tbody>
          <% submissions.forEach((batch) => { %>
            <tr>
              <td><span class="badge <%= batch.status === 'COMPLETED' ? 'success' : batch.status === 'FAILED' ? 'danger' : 'neutral' %>"><%= batch.status %></span></td>
              <td><%= batch.urls.length %></td>
              <td><%= batch.attemptCount %></td>
              <td><%= batch.responseStatusCode ?? '—' %></td>
              <td><%= batch.errorCode ?? '—' %></td>
              <td><%= batch.createdAt.toLocaleString('zh-CN') %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>

<section class="panel table-panel">
  <div class="panel-header crawler-panel-header">
    <div>
      <h3>历史任务</h3>
      <p>共 <strong><%= total %></strong> 次抓取。QUEUED / RUNNING 的统计属于当前进度。</p>
    </div>
  </div>
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>状态</th>
          <th>类型</th>
          <th>开始时间</th>
          <th>完成时间</th>
          <th>发现页面</th>
          <th>已抓取</th>
          <th>成功</th>
          <th>失败</th>
        </tr>
      </thead>
      <tbody>
        <% if (!runs.length) { %>
          <tr><td class="empty-cell" colspan="8">暂无抓取记录。通过 API 发起首次抓取后会在这里显示。</td></tr>
        <% } %>
        <% runs.forEach((run) => { const badgeClass = run.status === 'COMPLETED' ? 'success' : run.status === 'FAILED' ? 'danger' : run.status === 'RUNNING' ? 'running' : 'neutral'; %>
          <tr>
            <td><a href="/crawls/<%= run.id %>"><span class="badge <%= badgeClass %>"><%= run.status %></span></a></td>
            <td><a class="link-primary" href="/crawls/<%= run.id %>"><%= run.runType %></a></td>
            <td><%= run.startedAt ? new Date(run.startedAt).toLocaleString('zh-CN') : '—' %></td>
            <td><%= run.finishedAt ? new Date(run.finishedAt).toLocaleString('zh-CN') : '—' %></td>
            <td><%= run.pagesDiscovered %></td>
            <td><%= run.pagesCrawled %></td>
            <td><%= run.pagesSucceeded %></td>
            <td><%= run.pagesFailed %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</section>
