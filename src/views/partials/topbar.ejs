<header class="topbar" data-ui="topbar">
  <div>
    <p class="eyebrow">SEO GEO Intelligence Platform</p>
    <h1><%= title %></h1>
  </div>
  <div class="topbar-actions">
    <span class="status-dot" aria-hidden="true"></span>
    <span>P10 · Identity &amp; RBAC</span>
    <% if (typeof auth !== 'undefined' && auth) { %>
      <span class="badge success">已认证</span>
    <% } else { %>
      <span class="badge neutral">访客</span>
    <% } %>
    <button class="icon-button" type="button" aria-label="通知" title="通知">●</button>
    <div class="avatar" aria-label="SEO GEO">SG</div>
  </div>
</header>
