<% const facts = report.factSnapshot || {}; const seo = facts.seo || {}; const geo = facts.geo || {}; const content = facts.content || {}; const competitors = facts.competitors || {}; const visibility = facts.visibility || null; const advisory = report.advisorySnapshot || {}; const advisoryAi = Array.isArray(advisory.ai) ? advisory.ai : []; const executiveResult = executiveTask?.runs?.[0]?.result ?? null; const formatMetricRatio = (metric) => metric && metric.status === 'CALCULATED' && typeof metric.ratio === 'number' ? `${(metric.ratio * 100).toFixed(1)}%` : (metric?.status || 'UNKNOWN'); const formatCoverageRatio = (coverage) => coverage && typeof coverage.ratio === 'number' ? `${(coverage.ratio * 100).toFixed(1)}%` : 'UNKNOWN'; const formatDelta = (value) => typeof value === 'number' ? `${value > 0 ? '+' : ''}${value} bp` : 'UNKNOWN'; %>
<section class="page-header">
  <div>
    <p class="eyebrow">Reporting · P6-D</p>
    <h1>项目报告</h1>
    <p class="muted"><%= report.reportVersion %> · <%= new Date(report.createdAt).toLocaleString('zh-CN') %></p>
  </div>
  <div class="actions">
    <a class="button secondary" href="/projects/<%= project.id %>/reports">返回报告中心</a>
    <a class="button secondary" href="/api/v1/projects/<%= project.id %>/reports/<%= report.id %>/export.json">下载 JSON</a>
    <button class="button secondary" type="button" onclick="window.print()">打印</button>
  </div>
</section>

<section class="panel">
  <h2>确定性事实</h2>
  <p class="muted">以下数据来自报告生成时已经持久化的事实快照。缺失或 UNKNOWN 状态不会按 0 处理。</p>
</section>

<section class="metric-grid compact">
  <article class="metric-card"><div class="metric-title">SEO Score</div><div class="metric-value"><%= seo.score?.value ?? 'UNKNOWN' %></div><div class="metric-caption">Open issues: <%= seo.openIssues?.total ?? 0 %></div></article>
  <article class="metric-card"><div class="metric-title">GEO Score</div><div class="metric-value"><%= geo.score?.value ?? 'UNKNOWN' %></div><div class="metric-caption"><%= geo.score ? 'GEO_READINESS_V1' : 'UNKNOWN' %></div></article>
  <article class="metric-card"><div class="metric-title">Content Docs</div><div class="metric-value"><%= content.documentCount ?? 0 %></div><div class="metric-caption">Open opportunities: <%= content.openOpportunityCount ?? 0 %></div></article>
  <article class="metric-card"><div class="metric-title">Competitors</div><div class="metric-value"><%= competitors.count ?? 0 %></div><div class="metric-caption">Compared: <%= competitors.comparedCount ?? 0 %></div></article>
</section>

<% if (visibility) { %>
<section class="panel">
  <div class="panel-header"><div><h2>AI Visibility</h2><p class="muted">仅展示 PROJECT_REPORT_V2 生成时冻结的 P6 持久化事实，不在报告页面重新采样或计算。</p></div></div>
  <p class="muted">窗口：<%= new Date(visibility.snapshot.windowStart).toLocaleString('zh-CN') %> — <%= new Date(visibility.snapshot.windowEnd).toLocaleString('zh-CN') %> · <%= visibility.snapshot.formulaVersion %></p>
  <div class="metric-grid compact">
    <article class="metric-card"><div class="metric-title">Mention Rate</div><div class="metric-value"><%= formatMetricRatio(visibility.metrics?.mentionRate) %></div><div class="metric-caption"><%= visibility.metrics?.mentionRate?.status ?? 'UNKNOWN' %></div></article>
    <article class="metric-card"><div class="metric-title">Citation Rate</div><div class="metric-value"><%= formatMetricRatio(visibility.metrics?.citationRate) %></div><div class="metric-caption"><%= visibility.metrics?.citationRate?.status ?? 'UNKNOWN' %></div></article>
    <article class="metric-card"><div class="metric-title">Owned SOV</div><div class="metric-value"><%= formatMetricRatio(visibility.metrics?.ownedSov) %></div><div class="metric-caption"><%= visibility.metrics?.ownedSov?.status ?? 'UNKNOWN' %></div></article>
    <article class="metric-card"><div class="metric-title">Evidence Coverage</div><div class="metric-value"><%= formatCoverageRatio(visibility.evidenceCoverage) %></div><div class="metric-caption"><%= visibility.evidenceCoverage?.completedExtractionCount ?? 0 %> / <%= visibility.evidenceCoverage?.candidateObservationCount ?? 0 %> completed</div></article>
    <article class="metric-card"><div class="metric-title">Open Alerts</div><div class="metric-value"><%= visibility.alerts?.openTotal ?? 0 %></div><div class="metric-caption">INFO <%= visibility.alerts?.bySeverity?.INFO ?? 0 %> · WARNING <%= visibility.alerts?.bySeverity?.WARNING ?? 0 %> · CRITICAL <%= visibility.alerts?.bySeverity?.CRITICAL ?? 0 %></div></article>
  </div>

  <% if (visibility.comparison) { %>
  <h3>兼容历史比较</h3>
  <p class="muted">Previous snapshot: <%= visibility.comparison.previousSnapshotId %> · gap <%= visibility.comparison.gapDurationMs %> ms。存在 gap 时不宣称连续周环比/月环比。</p>
  <div class="table-wrap"><table><thead><tr><th>Metric</th><th>Actor</th><th>Previous</th><th>Current</th><th>Delta</th></tr></thead><tbody>
    <% for (const row of visibility.comparison.deltas || []) { %>
      <tr><td><%= row.metricType %></td><td><%= row.actorKey %></td><td><%= row.previousMetricStatus %></td><td><%= row.currentMetricStatus %></td><td><%= formatDelta(row.deltaBasisPoints) %></td></tr>
    <% } %>
  </tbody></table></div>
  <% } else { %>
    <p class="muted">当前快照没有可兼容的历史比较；不会生成虚假的 0 delta。</p>
  <% } %>

  <% if (Array.isArray(visibility.competitorSov) && visibility.competitorSov.length) { %>
  <h3>Competitor SOV（最多 20）</h3>
  <div class="table-wrap"><table><thead><tr><th>Actor</th><th>Status</th><th>SOV</th></tr></thead><tbody>
    <% for (const row of visibility.competitorSov) { %><tr><td><%= row.actorKey %></td><td><%= row.status %></td><td><%= row.status === 'CALCULATED' && typeof row.ratio === 'number' ? `${(row.ratio * 100).toFixed(1)}%` : row.status %></td></tr><% } %>
  </tbody></table></div>
  <% } %>
</section>
<% } %>

<section class="panel">
  <h2>SEO / Content 优先级事实</h2>
  <div class="table-wrap"><table><thead><tr><th>区域</th><th>HIGH / CRITICAL</th><th>MEDIUM</th><th>LOW</th></tr></thead><tbody>
    <tr><td>SEO Issues</td><td><%= (seo.openIssues?.bySeverity?.CRITICAL ?? 0) + (seo.openIssues?.bySeverity?.HIGH ?? 0) %></td><td><%= seo.openIssues?.bySeverity?.MEDIUM ?? 0 %></td><td><%= seo.openIssues?.bySeverity?.LOW ?? 0 %></td></tr>
    <tr><td>Content Opportunities</td><td><%= content.byPriority?.HIGH ?? 0 %></td><td><%= content.byPriority?.MEDIUM ?? 0 %></td><td><%= content.byPriority?.LOW ?? 0 %></td></tr>
  </tbody></table></div>
</section>

<section class="panel">
  <h2>Competitor Gap 状态</h2>
  <div class="metric-grid compact">
    <article class="metric-card"><div class="metric-title">AHEAD</div><div class="metric-value"><%= competitors.gapStates?.AHEAD ?? 0 %></div></article>
    <article class="metric-card"><div class="metric-title">BEHIND</div><div class="metric-value"><%= competitors.gapStates?.BEHIND ?? 0 %></div></article>
    <article class="metric-card"><div class="metric-title">EVEN</div><div class="metric-value"><%= competitors.gapStates?.EVEN ?? 0 %></div></article>
    <article class="metric-card"><div class="metric-title">UNKNOWN</div><div class="metric-value"><%= competitors.gapStates?.UNKNOWN ?? 0 %></div></article>
  </div>
</section>

<section class="panel">
  <div class="panel-header"><div><h2>AI 建议 / Executive Summary</h2><p class="muted">以下内容全部是建议性输出，不改变上面的确定性事实。</p></div></div>
  <% if (!report.executiveAiTaskId) { %>
    <form action="/projects/<%= project.id %>/reports/<%= report.id %>/ai-summary" method="post"><button class="button" type="submit">生成 DeepSeek Executive Summary</button></form>
  <% } else { %>
    <p><strong>Executive AI Task:</strong> <a href="/projects/<%= project.id %>/ai/tasks/<%= report.executiveAiTaskId %>"><%= report.executiveAiTaskId %></a> · <%= executiveTask?.status ?? 'UNKNOWN' %></p>
    <% if (executiveResult) { %><article class="nested-panel"><strong>Executive Summary</strong><p><%= executiveResult.summary %></p></article><% } %>
  <% } %>

  <h3>已保存 AI Advisory</h3>
  <% for (const item of advisoryAi) { %>
    <article class="nested-panel"><div><strong><%= item.taskType %></strong> · <a href="/projects/<%= project.id %>/ai/tasks/<%= item.taskId %>"><%= item.taskId %></a></div><p><%= item.summary %></p></article>
  <% } %>
  <% if (!advisoryAi.length && !executiveResult) { %><p class="muted">当前没有已完成的 AI advisory。报告事实本身仍然完整可用。</p><% } %>
</section>

<section class="panel">
  <h2>边界声明</h2>
  <% if (visibility) { %>
    <p class="muted">本 V2 报告的 AI Visibility、Citation Rate 与 Share of Voice 均来自已持久化的确定性 P6 快照。报告生成不会触发新的采样、提取、指标计算或外部网络调用。</p>
  <% } else { %>
    <p class="muted">本报告没有冻结 P6 AI Visibility 事实；不会把缺失的可见度、引用或 Share of Voice 数据伪装为 0。</p>
  <% } %>
</section>
