<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="color-scheme" content="light">
  <title><%= title %> · SEO GEO</title>
  <link rel="stylesheet" href="/assets/css/app.css">
  <link rel="stylesheet" href="/assets/css/p10.css">
  <link rel="stylesheet" href="/assets/css/p10-ui-03.css">
  <link rel="stylesheet" href="/assets/css/p10-ui-04.css">
  <link rel="stylesheet" href="/assets/css/p10-ui-05.css">
  <link rel="stylesheet" href="/assets/css/p11-keywords.css">
</head>
<body>
  <a class="skip-link" href="#main-content">跳到主要内容</a>
  <%- include('partials/icon-sprite') %>
  <div class="app-shell" data-ui="app-shell">
    <%- include('partials/sidebar', { activeNav, currentProjectId }) %>
    <button class="nav-backdrop" type="button" data-ui="nav-backdrop" aria-label="关闭导航" tabindex="-1"></button>
    <div class="workspace">
      <%- include('partials/topbar', { title, currentProjectId }) %>
      <main class="workspace-main" id="main-content" tabindex="-1">
        <%- include(bodyTemplate) %>
      </main>
    </div>
  </div>
  <script src="/assets/js/app.js" defer></script>
  <% if (typeof pageScripts !== 'undefined') { %>
    <% for (const src of pageScripts) { %>
      <script src="<%= src %>" defer></script>
    <% } %>
  <% } %>
</body>
</html>