<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="color-scheme" content="light">
  <title><%= title %> · SEO GEO</title>
  <link rel="stylesheet" href="/assets/css/app.css">
  <link rel="stylesheet" href="/assets/css/p10.css">
</head>
<body>
  <div class="app-shell" data-ui="app-shell">
    <%- include('partials/sidebar', { activeNav }) %>
    <div class="workspace">
      <%- include('partials/topbar', { title }) %>
      <main class="workspace-main" id="main-content">
        <%- include(bodyTemplate) %>
      </main>
    </div>
  </div>
  <script src="/assets/js/app.js" defer></script>
  <% if (typeof pageScripts !== 'undefined') { %>
    <% for (const src of pageScripts) { %>
      <script src="<%= src %>" defer></script>
    <% } %>
  <% } %>
</body>
</html>
