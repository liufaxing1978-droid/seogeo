<section class="page-heading project-heading">
  <div><p class="eyebrow">项目详情</p><h2><%= project.name %></h2><p class="muted"><%= project.primaryDomain %></p></div>
  <div class="actions"><a class="button secondary" href="/projects/<%= project.id %>/seo">SEO 审计</a><a class="button secondary" href="/projects/<%= project.id %>/geo">GEO 审计</a><a class="button secondary" href="/projects/<%= project.id %>/search-console">Search Console</a><a class="button secondary" href="/projects/<%= project.id %>/growth">Growth Center</a></div>
</section>
<div class="project-meta">
  <span class="badge success"><%= project.status %></span>
  <span class="badge <%= project.planLevel === 'STANDARD' ? 'neutral' : 'premium' %>"><%= project.planLevel %></span>
  <span>语言 <strong><%= project.defaultLanguage %></strong></span>
  <span>地区 <strong><%= project.targetCountry %></strong></span>
  <span>时区 <strong><%= project.timezone %></strong></span>
</div>
<nav class="tabs">
  <% tabs.forEach((tab) => { const active = tab === '概览'; const enabled = tab === '概览' || tab === '设置'; %>
    <span class="tab <%= active ? 'active' : '' %> <%= enabled ? '' : 'disabled' %>"><%= tab %><% if (!enabled) { %><small> 后续</small><% } %></span>
  <% }) %>
</nav>
<section class="metric-grid compact">
  <article class="metric-card"><div class="metric-title">SEO Score</div><div class="metric-value"><%= dashboard.seoScore === null ? '--' : dashboard.seoScore.toFixed(1) %></div><div class="metric-caption">最新持久化 SEO Score</div></article>
  <article class="metric-card"><div class="metric-title">GEO Score</div><div class="metric-value"><%= dashboard.geoScore === null ? '--' : dashboard.geoScore.toFixed(1) %></div><div class="metric-caption">GEO_READINESS_V1</div></article>
  <article class="metric-card"><div class="metric-title">Citability</div><div class="metric-value"><%= !dashboard.citability || dashboard.citability.value === null ? (dashboard.citability?.status || '--') : dashboard.citability.value.toFixed(1) %></div><div class="metric-caption">最新 GEO Score 的 CITABILITY 组件</div></article>
  <article class="metric-card"><div class="metric-title">Critical Issues</div><div class="metric-value"><%= dashboard.criticalIssueCount %></div><div class="metric-caption">当前未解决 CRITICAL SEO 问题</div></article>
</section>

<%
  const growth = dashboard.growth;
  const formatGrowthPct = (value) => value === null ? 'UNKNOWN' : `${value >= 0 ? '+' : ''}${value.toFixed(1)}%`;
%>
<section class="panel" aria-label="Growth Intelligence">
  <div class="panel-header">
    <div>
      <h3>Growth Intelligence · 持久化事实</h3>
      <p>只读取已物化的 P7-A Growth 与 Search Console 事实；页面渲染不会调用 Google、P6 provider 或 DeepSeek。</p>
    </div>
    <a class="button secondary" href="/projects/<%= project.id %>/growth">打开 Growth Center</a>
  </div>

  <% if (growth.state === 'NO_DATA') { %>
    <div class="empty-state">
      <h4>暂无可排名机会</h4>
      <p>最新 Growth 窗口没有可用于权威排序的机会；UNKNOWN / PARTIAL 不会被转换为 0。</p>
    </div>
  <% } else { %>
    <section class="metric-grid compact">
      <article class="metric-card"><div class="metric-title">Top Growth Score</div><div class="metric-value"><%= growth.topEligibleScore %></div><div class="metric-caption"><%= growth.surface %> surface</div></article>
      <article class="metric-card"><div class="metric-title">CRITICAL Opportunities</div><div class="metric-value"><%= growth.criticalCount %></div><div class="metric-caption">最新稳定窗口</div></article>
      <article class="metric-card"><div class="metric-title">HIGH Opportunities</div><div class="metric-value"><%= growth.highCount %></div><div class="metric-caption">最新稳定窗口</div></article>
      <article class="metric-card"><div class="metric-title">Resolved</div><div class="metric-value"><%= growth.resolvedCount %></div><div class="metric-caption">当前可见 Growth surface</div></article>
    </section>
  <% } %>

  <div class="dashboard-grid">
    <article class="panel panel-wide">
      <h4>Search Console 趋势</h4>
      <% if (growth.searchTrend) { %>
        <dl class="detail-list">
          <div><dt>Impressions <%= formatGrowthPct(growth.searchTrend.impressionChangePct) %></dt><dd><%= growth.searchTrend.current.impressions %> / 前期 <%= growth.searchTrend.previous.impressions %></dd></div>
          <div><dt>Clicks <%= formatGrowthPct(growth.searchTrend.clickChangePct) %></dt><dd><%= growth.searchTrend.current.clicks %> / 前期 <%= growth.searchTrend.previous.clicks %></dd></div>
        </dl>
      <% } else { %>
        <div class="empty-state">稳定窗口内暂无足够 Search Console 持久化事实。</div>
      <% } %>
    </article>
    <article class="panel">
      <h4>GSC 数据健康</h4>
      <dl class="detail-list">
        <div><dt>连接</dt><dd><%= growth.gsc.connectionStatus %></dd></div>
        <div><dt>Property</dt><dd><%= growth.gsc.propertyUri || '—' %></dd></div>
        <div><dt>最新完成日期</dt><dd><%= growth.gsc.latestCompletedDate || 'NO_DATA' %></dd></div>
        <div><dt>Completeness</dt><dd><%= growth.gsc.sourceCompletenessState || 'UNKNOWN' %></dd></div>
      </dl>
    </article>
  </div>

  <% if (growth.state === 'AVAILABLE') { %>
    <div class="table-wrap"><table>
      <thead><tr><th>信号</th><th>Query</th><th>Score</th><th>Priority</th></tr></thead>
      <tbody>
        <% if (growth.topRankingUpside) { %><tr><td>Ranking Upside</td><td><%= growth.topRankingUpside.normalizedQuery %></td><td><%= growth.topRankingUpside.score %></td><td><%= growth.topRankingUpside.priority %></td></tr><% } %>
        <% if (growth.topDeclining) { %><tr><td>Declining</td><td><%= growth.topDeclining.normalizedQuery %></td><td><%= growth.topDeclining.score %></td><td><%= growth.topDeclining.priority %></td></tr><% } %>
        <% if (growth.topCannibalizationRisk) { %><tr><td>Cannibalization</td><td><%= growth.topCannibalizationRisk.normalizedQuery %></td><td><%= growth.topCannibalizationRisk.score %></td><td><%= growth.topCannibalizationRisk.priority %></td></tr><% } %>
      </tbody>
    </table></div>
  <% } %>
</section>

<% if (dashboard.visibility) { %>
  <section class="panel">
    <div class="panel-header"><div><h3>AI Visibility · 持久化事实</h3><p>只读取同一个最新完成 P6-C 快照；UNKNOWN / NO_DATA 不转换为 0。</p></div><a class="button secondary" href="/projects/<%= project.id %>/visibility/history">查看历史</a></div>
    <section class="metric-grid compact">
      <% [
        ['Owned Mention Rate', dashboard.visibility.mentionRate],
        ['Owned Citation Rate', dashboard.visibility.citationRate],
        ['Owned Mention SOV', dashboard.visibility.ownedSov]
      ].forEach(([label, metric]) => { %>
        <article class="metric-card">
          <div class="metric-title"><%= label %></div>
          <div class="metric-value"><%= metric.ratio === null ? metric.status : `${(metric.ratio * 100).toFixed(1)}%` %></div>
          <div class="metric-caption">Snapshot <%= dashboard.visibility.snapshotId.slice(0, 8) %></div>
        </article>
      <% }) %>
      <article class="metric-card"><div class="metric-title">Open Alerts</div><div class="metric-value"><%= dashboard.visibility.openAlertCount %></div><div class="metric-caption">站内未确认 / 未解决告警</div></article>
    </section>
  </section>
<% } else if (project.planLevel === 'STANDARD') { %>
  <section class="panel">
    <div class="panel-header"><div><h3>AI Visibility · 高级版</h3><p>升级到 Advanced 或 Enterprise 后显示持久化 Visibility 指标。</p></div></div>
  </section>
<% } else { %>
  <section class="panel"><div class="panel-header"><div><h3>AI Visibility</h3><p>尚无完成的 P6-C 指标快照。</p></div></div></section>
<% } %>

<section class="dashboard-grid">
  <article class="panel panel-wide"><h3>项目概览</h3><dl class="detail-list"><div><dt>主域名</dt><dd><%= project.primaryDomain %></dd></div><div><dt>行业</dt><dd><%= project.industry || '未设置' %></dd></div><div><dt>创建时间</dt><dd><%= new Date(project.createdAt).toLocaleString('zh-CN') %></dd></div></dl></article>
  <article class="panel"><h3>数据原则</h3><div class="empty-state">Dashboard 只显示已落库事实；AI 分析与采样不会在页面渲染时触发。</div></article>
</section>
