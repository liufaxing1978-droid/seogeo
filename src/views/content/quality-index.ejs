<section class="product-center" data-ui="content-quality-center">
  <section class="product-center-hero">
    <div>
      <p class="eyebrow">规则驱动 · 证据优先</p>
      <h1>内容质量建议</h1>
      <p class="muted"><%= project.name %> · 仅展示已保存的快照和规则判断。</p>
    </div>
    <% if (canWriteQuality) { %>
      <form action="/projects/<%= project.id %>/content/quality/runs" method="post">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="button" type="submit">分析内容质量</button>
      </form>
    <% } %>
  </section>

  <section class="truth-boundary-card">
    <div>
      <p class="eyebrow">审核边界</p>
      <h2>人工审核后才会创建提案</h2>
      <p class="muted">此处只供查看和人工审核；接受建议只会创建一个待处理提案。</p>
    </div>
  </section>

  <section class="panel product-table-panel" data-ui="content-quality-runs">
    <div class="panel-header"><div><h2>分析记录</h2><p class="muted">规则集版本、输入快照截止时间与已保存的结果。</p></div></div>
    <div class="table-wrap"><table><thead><tr><th>运行 ID</th><th>规则集版本</th><th>状态</th><th>快照截止时间</th><th>文档 / 发现</th><th>完成时间</th></tr></thead><tbody>
      <% for (const run of runs) { %><tr>
        <td><code><%= run.id %></code></td><td><%= run.rulesetVersion %></td><td><%= run.status %></td>
        <td><%= run.inputSnapshotCutoffAt ? new Date(run.inputSnapshotCutoffAt).toLocaleString('zh-CN') : '证据不足' %></td>
        <td><%= run.inputDocumentCount %> / <%= run.findingCount %></td>
        <td><%= run.completedAt ? new Date(run.completedAt).toLocaleString('zh-CN') : '—' %></td>
      </tr><% } %>
      <% if (!runs.length) { %><tr><td colspan="6" class="muted">尚无分析记录。可由有写入权限的成员发起人工分析。</td></tr><% } %>
    </tbody></table></div>
  </section>

  <section class="panel product-table-panel" data-ui="content-quality-findings">
    <div class="panel-header"><div><h2>规则发现</h2><p class="muted">优先级和状态来自规则执行；缺少可比证据时明确标记为“证据不足”。</p></div></div>
    <div class="table-wrap"><table><thead><tr><th>优先级</th><th>状态</th><th>规则版本</th><th>页面</th><th>建议</th><th>快照证据</th><th>最后发现</th></tr></thead><tbody>
      <% for (const finding of findings) { const evidence = evidenceModel(finding.evidence); %><tr>
        <td><span class="badge"><%= finding.priority %></span></td><td><%= finding.status %></td><td><%= finding.ruleVersion %></td>
        <td><%= finding.document.title ?? finding.document.canonicalUrl %></td>
        <td><a href="/projects/<%= project.id %>/content/quality/<%= finding.id %>"><%= finding.summary %></a></td>
        <td><%= evidence.status === 'UNKNOWN' ? '证据不足' : (evidence.references.map((reference) => reference.id).join('、') || '证据不足') %></td>
        <td><%= new Date(finding.lastDetectedAt).toLocaleString('zh-CN') %></td>
      </tr><% } %>
      <% if (!findings.length) { %><tr><td colspan="7" class="muted">暂无规则发现。</td></tr><% } %>
    </tbody></table></div>
  </section>
</section>
