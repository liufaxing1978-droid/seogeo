<section class="page-header">
  <div>
    <p class="eyebrow">AI Visibility · P6-B</p>
    <h1>Extraction 详情</h1>
    <p class="muted"><%= project.name %> · 单次不可变 extraction 的安全事实视图。</p>
  </div>
  <div class="actions"><a class="button" href="/projects/<%= project.id %>/visibility/citations">返回 Citation 监控</a></div>
</section>

<section class="panel">
  <div class="panel-header"><div><h2>Provenance</h2><p class="muted">这些字段用于历史重放和审计；页面不显示 prompt、answer、reasoning 或 provider raw body。</p></div></div>
  <div class="table-wrap"><table>
    <tbody>
      <tr><th>Extraction ID</th><td><code><%= extraction.id %></code></td></tr>
      <tr><th>Observation ID</th><td><code><%= extraction.platformObservationId %></code></td></tr>
      <tr><th>Status</th><td><%= extraction.status %></td></tr>
      <tr><th>Extractor Version</th><td><code><%= extraction.extractorVersion %></code></td></tr>
      <tr><th>Subject Set Hash</th><td><code><%= extraction.subjectSetHash %></code></td></tr>
      <tr><th>Mention Evidence</th><td><%= extraction.mentionStatus %></td></tr>
      <tr><th>Citation Evidence</th><td><%= extraction.citationStatus %></td></tr>
      <tr><th>Mention Count</th><td><%= extraction.mentionCount %></td></tr>
      <tr><th>Citation Count</th><td><%= extraction.citationCount %></td></tr>
      <tr><th>Error Code</th><td><%= extraction.errorCode ?? '—' %></td></tr>
      <tr><th>Completed</th><td><%= extraction.completedAt ? new Date(extraction.completedAt).toLocaleString('zh-CN') : '—' %></td></tr>
    </tbody>
  </table></div>
</section>

<section class="panel">
  <div class="panel-header"><div><h2>Mention Facts</h2></div></div>
  <div class="table-wrap"><table>
    <thead><tr><th>Subject</th><th>Matched</th><th>Type</th><th>Count</th><th>First Position</th></tr></thead>
    <tbody>
      <% for (const item of mentions) { %><tr><td><%= item.subjectValue %></td><td><%= item.matchedValue %></td><td><%= item.mentionType %></td><td><%= item.occurrenceCount %></td><td><%= item.firstPosition ?? '—' %></td></tr><% } %>
      <% if (!mentions.length) { %><tr><td colspan="5" class="muted">本 extraction 没有 Mention rows。请结合 Mention Evidence 状态解释；UNKNOWN/NOT_ELIGIBLE 不等于零。</td></tr><% } %>
    </tbody>
  </table></div>
</section>

<section class="panel">
  <div class="panel-header"><div><h2>Citation Facts</h2></div></div>
  <div class="table-wrap"><table>
    <thead><tr><th>Domain</th><th>Normalized URL</th><th>Position</th><th>Count</th><th>Owned</th></tr></thead>
    <tbody>
      <% for (const item of citations) { %><tr><td><%= item.domain %></td><td><%= item.normalizedUrl %></td><td><%= item.position ?? '—' %></td><td><%= item.occurrenceCount %></td><td><%= item.isOwnedDomain ? '是' : '否' %></td></tr><% } %>
      <% if (!citations.length) { %><tr><td colspan="5" class="muted">本 extraction 没有 Citation rows。请结合 Citation Evidence 状态解释；UNKNOWN/NOT_ELIGIBLE 不等于零。</td></tr><% } %>
    </tbody>
  </table></div>
</section>
