<% const pct = (value) => value == null ? '—' : `${(value * 100).toFixed(1)}%`; %>
<div class="analysis-center" data-ui="visibility-center">
<section class="page-header analysis-hero">
  <div>
    <p class="eyebrow">AI Visibility · P6</p>
    <h1>AI Visibility</h1>
    <p class="muted"><%= project.name %> · <%= project.primaryDomain %></p>
  </div>
  <div class="actions">
    <a class="button secondary" href="/projects/<%= project.id %>/visibility/history">历史趋势</a>
    <a class="button secondary" href="/projects/<%= project.id %>/visibility/alerts">告警</a>
    <a class="button" href="/projects/<%= project.id %>/visibility/prompts">配置 Prompt</a>
  </div>
</section>

<%- include('../partials/geo-center-nav', { project, geoCenterActive: 'visibility' }) %>

<section class="panel analysis-evidence-note">
  <div class="panel-header">
    <div>
      <h2>官方 API 可见性采样</h2>
      <p class="muted">采样记录官方 Provider API 的观察结果；它不等同于消费者产品网页端排名或展示结果。</p>
    </div>
    <span class="badge">API 采样</span>
  </div>
</section>

<% if (visibilitySummary) { %>
<section class="panel analysis-table-panel" data-ui="visibility-metrics-summary">
  <div class="panel-header">
    <div><h2>最新 Visibility 指标</h2><p class="muted">全部来自同一个最新 COMPLETED P6-C snapshot；UNKNOWN / NO_DATA 不会按 0 计算。</p></div>
    <span class="badge"><%= visibilitySummary.snapshot.formulaVersion %></span>
  </div>
  <section class="metric-grid compact analysis-metric-grid">
    <article class="metric-card"><div class="metric-title">Owned Mention Rate</div><div class="metric-value"><%= pct(visibilitySummary.mentionRate?.ratio ?? null) %></div><div class="metric-caption"><%= visibilitySummary.mentionRate?.status ?? 'NO_DATA' %></div></article>
    <article class="metric-card"><div class="metric-title">Owned Citation Rate</div><div class="metric-value"><%= pct(visibilitySummary.citationRate?.ratio ?? null) %></div><div class="metric-caption"><%= visibilitySummary.citationRate?.status ?? 'NO_DATA' %></div></article>
    <article class="metric-card"><div class="metric-title">Owned Mention SOV</div><div class="metric-value"><%= pct(visibilitySummary.ownedSov?.ratio ?? null) %></div><div class="metric-caption"><%= visibilitySummary.ownedSov?.status ?? 'NO_DATA' %></div></article>
    <article class="metric-card"><div class="metric-title">Evidence Coverage</div><div class="metric-value"><%= pct(visibilitySummary.evidenceCoverageRatio) %></div><div class="metric-caption"><%= visibilitySummary.snapshot.completedExtractionCount %>/<%= visibilitySummary.snapshot.candidateObservationCount %></div></article>
  </section>
  <div class="table-wrap"><table>
    <tbody>
      <tr><th>Measurement Window</th><td><%= new Date(visibilitySummary.snapshot.windowStart).toLocaleDateString('zh-CN') %> → <%= new Date(visibilitySummary.snapshot.windowEnd).toLocaleDateString('zh-CN') %></td><th>Input Cutoff</th><td><%= new Date(visibilitySummary.snapshot.inputCutoffAt).toLocaleString('zh-CN') %></td></tr>
      <tr><th>Provider Coverage</th><td><%= visibilitySummary.providerCoverageCount %> 个 provider 维度</td><th>Open Alerts</th><td><%= visibilitySummary.openAlertCount %></td></tr>
      <tr><th>Extractor</th><td><%= visibilitySummary.snapshot.extractorVersion %></td><th>Latest Comparison</th><td><%= visibilitySummary.comparison ? visibilitySummary.comparison.id : 'NO_COMPATIBLE_PREVIOUS' %></td></tr>
    </tbody>
  </table></div>
  <% if (visibilitySummary.comparison?.deltas?.length) { %>
    <div class="table-wrap"><table><thead><tr><th>Metric</th><th>Previous → Current</th><th>Delta</th></tr></thead><tbody>
      <% for (const delta of visibilitySummary.comparison.deltas) { %><tr><td><%= delta.metricType %></td><td><%= delta.previousMetricStatus %> → <%= delta.currentMetricStatus %></td><td><%= delta.deltaBasisPoints == null ? '—' : `${delta.deltaBasisPoints > 0 ? '+' : ''}${delta.deltaBasisPoints} bp` %></td></tr><% } %>
    </tbody></table></div>
  <% } %>
</section>
<% } else { %>
<section class="panel"><div class="panel-header"><div><h2>Visibility 指标</h2><p class="muted">尚无完成的 P6-C metric snapshot。页面访问不会触发采样或指标计算。</p></div></div></section>
<% } %>

<section class="metric-grid compact analysis-metric-grid">
  <article class="metric-card">
    <div class="metric-title">Provider 配置</div>
    <div class="metric-value"><%= providers.length %></div>
    <div class="metric-caption"><%= providers.filter((provider) => provider.enabled).length %> 个启用</div>
  </article>
  <article class="metric-card">
    <div class="metric-title">Prompt</div>
    <div class="metric-value"><%= promptCount %></div>
    <div class="metric-caption"><%= promptSetCount %> 个 Prompt Set</div>
  </article>
  <article class="metric-card">
    <div class="metric-title">API Observations</div>
    <div class="metric-value"><%= observationCount %></div>
    <div class="metric-caption">仅统计已持久化采样单元</div>
  </article>
  <article class="metric-card">
    <div class="metric-title">预算记录</div>
    <div class="metric-value"><%= (recordedSpendMicros / 1000000).toFixed(4) %></div>
    <div class="metric-caption"><%= settings?.defaultCurrency ?? 'USD' %> · 历史成本不重定价</div>
  </article>
</section>

<section class="panel">
  <div class="panel-header">
    <div><h2>预算与采样上限</h2><p class="muted">付费请求在 visibility worker 执行前进行预算预检。</p></div>
  </div>
  <div class="table-wrap">
    <table>
      <thead><tr><th>每日预算</th><th>默认单次运行预算</th><th>每次最大观察数</th><th>定时采样</th></tr></thead>
      <tbody><tr>
        <td><%= settings?.dailyBudgetMicros == null ? '未配置' : `${(settings.dailyBudgetMicros / 1000000).toFixed(4)} ${settings.defaultCurrency}` %></td>
        <td><%= settings?.defaultRunBudgetMicros == null ? '未配置' : `${(settings.defaultRunBudgetMicros / 1000000).toFixed(4)} ${settings.defaultCurrency}` %></td>
        <td><%= settings?.maxObservationsPerRun ?? 100 %></td>
        <td><%= settings?.schedulingEnabled ? '已启用' : '未启用' %></td>
      </tr></tbody>
    </table>
  </div>
</section>

<section class="panel analysis-table-panel">
  <div class="panel-header"><div><h2>Provider API 配置</h2><p class="muted">P6-A 仅支持 channel=API；消费者 UI 自动化不在本阶段范围。</p></div></div>
  <div class="table-wrap"><table>
    <thead><tr><th>Provider</th><th>Model</th><th>Channel</th><th>Grounding</th><th>状态</th><th>并发</th></tr></thead>
    <tbody>
      <% for (const provider of providers) { %>
        <tr><td><strong><%= provider.provider %></strong></td><td><%= provider.model %></td><td><span class="badge"><%= provider.channel %></span></td><td><%= provider.groundingMode %></td><td><%= provider.enabled ? '启用' : '停用' %></td><td><%= provider.maxConcurrency %></td></tr>
      <% } %>
      <% if (!providers.length) { %><tr><td colspan="6" class="muted">尚未配置 Provider API。可先在 API/配置层启用支持的 Provider。</td></tr><% } %>
    </tbody>
  </table></div>
</section>

<section class="panel analysis-table-panel">
  <div class="panel-header"><div><h2>最近采样运行</h2><p class="muted">这里展示采样状态与观察数量，不在渲染阶段重新推导提及/引用事实。</p></div></div>
  <div class="table-wrap"><table>
    <thead><tr><th>运行</th><th>类型</th><th>状态</th><th>观察数</th><th>预算上限</th><th>创建时间</th></tr></thead>
    <tbody>
      <% for (const run of recentRuns) { %>
        <tr>
          <td><a href="/projects/<%= project.id %>/visibility/runs/<%= run.id %>"><%= run.id.slice(0, 8) %></a></td>
          <td><%= run.runType %></td><td><span class="badge"><%= run.status %></span></td><td><%= run._count.observations %></td>
          <td><%= run.budgetCeilingMicros == null ? '未配置' : `${(run.budgetCeilingMicros / 1000000).toFixed(4)} ${run.currency}` %></td>
          <td><%= new Date(run.createdAt).toLocaleString('zh-CN') %></td>
        </tr>
      <% } %>
      <% if (!recentRuns.length) { %><tr><td colspan="6" class="muted">尚无采样运行。先在 Prompt 监控建立版本化 Prompt，再通过受控 API 发起采样。</td></tr><% } %>
    </tbody>
  </table></div>
</section>
</div>
