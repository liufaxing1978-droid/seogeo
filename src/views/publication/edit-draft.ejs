<section class="page-header"><div><p class="eyebrow">Content Draft · V<%= draft.currentVersion %></p><h1>编辑草稿</h1><p class="muted">保存后生成新版本，不会发布。</p></div><div class="actions"><a class="button secondary" href="/projects/<%= project.id %>/publication/drafts/<%= draft.id %>">取消</a></div></section>
<section class="panel"><form method="post" action="/projects/<%= project.id %>/publication/drafts/<%= draft.id %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="form-grid"><label>标题<input name="title" required value="<%= values.title ?? '' %>"></label><label>URL slug<input name="slugCandidate" value="<%= values.slugCandidate ?? '' %>"></label><label>摘要<textarea name="excerpt"><%= values.excerpt ?? '' %></textarea></label><label>Meta 标题<input name="metaTitle" value="<%= values.metaTitle ?? '' %>"></label><label>Meta 描述<textarea name="metaDescription"><%= values.metaDescription ?? '' %></textarea></label><label>规范 URL<input name="canonicalCandidate" value="<%= values.canonicalCandidate ?? '' %>"></label><label>作者<input name="author" value="<%= values.author ?? '' %>"></label><label>语言<input name="language" required value="<%= values.language ?? 'zh-CN' %>"></label></div><label>正文<textarea name="body" required rows="24"><%= values.body ?? '' %></textarea></label><% if (errors.title) { %><p class="error"><%= errors.title.join(' ') %></p><% } %><% if (errors.body) { %><p class="error"><%= errors.body.join(' ') %></p><% } %><p><button class="button" type="submit">保存为新版本</button></p></form></section>
