enum MarketCode {
  CN
  GLOBAL
  HK
  TW
  SG
  MY
}

model ProjectMarket {
  id         String     @id @default(uuid()) @db.Uuid
  projectId  String     @db.Uuid
  marketCode MarketCode
  locale     String
  enabled    Boolean    @default(true)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, marketCode, locale], map: "ProjectMarket_project_market_locale_key")
  @@index([projectId, enabled], map: "ProjectMarket_project_enabled_idx")
  @@index([marketCode, locale], map: "ProjectMarket_market_locale_idx")
}
