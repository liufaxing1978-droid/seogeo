enum AiTaskType {
  SEO_AUDIT_ANALYSIS
  GEO_READINESS_ANALYSIS
  ENTITY_ENRICHMENT
  CONTENT_BRIEF
  CONTENT_OPTIMIZATION_ANALYSIS
  COMPETITOR_GAP_ANALYSIS
  REPORT_EXECUTIVE_SUMMARY
  VISIBILITY_TREND_ANALYSIS
  GROWTH_OPPORTUNITY_EXPLANATION
  PUBLICATION_CONTENT_BRIEF
  PUBLICATION_ARTICLE_GENERATION
  PUBLICATION_CONTENT_ADAPTATION
  OPTIMIZATION_PLAN_RANKING
  KEYWORD_EXPANSION
}

enum AiTaskStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

enum AiRunStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum AiProviderName {
  DEEPSEEK
}

enum AiMode {
  FAST
  REASONING
}

enum AiResponseFormat {
  TEXT
  JSON
}

model AiTask {
  id               String       @id @default(uuid()) @db.Uuid
  projectId        String       @db.Uuid
  taskType         AiTaskType
  status           AiTaskStatus @default(QUEUED)
  requestKey       String
  promptVersion    String
  factSnapshot     Json
  sourceReferences Json
  errorCode        String?
  errorMessage     String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  runs AiTaskRun[]

  @@unique([projectId, requestKey])
  @@index([projectId, createdAt])
  @@index([projectId, status])
}

model AiTaskRun {
  id             String           @id @default(uuid()) @db.Uuid
  aiTaskId       String           @db.Uuid
  attemptNo      Int
  provider       AiProviderName
  model          String
  mode           AiMode
  responseFormat AiResponseFormat
  status         AiRunStatus
  promptVersion  String
  requestHash    String
  startedAt      DateTime         @default(now())
  finishedAt     DateTime?
  errorCode      String?
  errorMessage   String?
  httpStatus     Int?
  latencyMs      Int?
  promptTokens   Int?
  completionTokens Int?
  totalTokens    Int?
  cacheHitTokens Int?
  cacheMissTokens Int?
  reasoningTokens Int?
  responseId     String?
  finishedContent String?

  task AiTask @relation(fields: [aiTaskId], references: [id], onDelete: Cascade)

  @@unique([aiTaskId, attemptNo])
  @@index([status, startedAt])
}

model AiTaskResult {
  id            String   @id @default(uuid()) @db.Uuid
  aiTaskId      String   @unique @db.Uuid
  outputJson    Json
  summary       String?
  provider      AiProviderName
  model         String
  responseId    String?
  createdAt     DateTime @default(now())

  task AiTask @relation(fields: [aiTaskId], references: [id], onDelete: Cascade)
}
