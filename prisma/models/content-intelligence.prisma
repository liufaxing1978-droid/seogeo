enum ContentSignalStatus {
  PASS
  FAIL
  UNKNOWN
}

enum ContentPriority {
  INFO
  LOW
  MEDIUM
  HIGH
}

enum ContentOpportunityStatus {
  OPEN
  IN_PROGRESS
  IGNORED
  VERIFIED_FIXED
}

enum ContentQualityRunStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

enum ContentQualityFindingStatus {
  OPEN
  IN_REVIEW
  ACCEPTED
  DISMISSED
}

enum ContentQualityCategory {
  INTERNAL_LINK_SUPPORT
  CONTENT_DECAY
  CONTENT_QA
}

model ContentDocument {
  id                   String   @id @default(uuid()) @db.Uuid
  projectId            String   @db.Uuid
  pageId               String   @db.Uuid
  latestPageSnapshotId String   @db.Uuid
  canonicalUrl         String
  title                String?
  metaDescription      String?
  h1                   String?
  language             String?
  wordCount            Int?
  paragraphCount       Int?
  headingCount         Int?
  listCount            Int?
  tableCount           Int?
  imageCount           Int?
  internalLinkCount    Int?
  externalLinkCount    Int?
  schemaTypes          Json
  contentHash          String
  extractedAt          DateTime
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  signals       ContentSignal[]
  opportunities ContentOpportunity[]
  briefs        ContentBrief[]
  qualityFindings ContentQualityFinding[]

  @@unique([projectId, pageId])
  @@index([projectId, extractedAt])
  @@index([latestPageSnapshotId])
  @@index([contentHash])
}

model ContentSignal {
  id                String              @id @default(uuid()) @db.Uuid
  projectId         String              @db.Uuid
  contentDocumentId String              @db.Uuid
  ruleKey           String
  ruleVersion       Int
  status            ContentSignalStatus
  priority          ContentPriority
  numericValue      Float?
  textValue         String?
  sourceReferences  Json
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  document ContentDocument @relation(fields: [contentDocumentId], references: [id], onDelete: Cascade)

  @@unique([contentDocumentId, ruleKey, ruleVersion])
  @@index([projectId, status])
  @@index([projectId, ruleKey])
}

model ContentOpportunity {
  id                 String                   @id @default(uuid()) @db.Uuid
  projectId          String                   @db.Uuid
  contentDocumentId  String                   @db.Uuid
  opportunityKey     String
  opportunityVersion Int
  category           String
  priority           ContentPriority
  status             ContentOpportunityStatus @default(OPEN)
  summary            String
  sourceReferences   Json
  firstDetectedAt    DateTime
  lastDetectedAt     DateTime
  verifiedFixedAt    DateTime?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  document ContentDocument @relation(fields: [contentDocumentId], references: [id], onDelete: Cascade)

  @@unique([contentDocumentId, opportunityKey, opportunityVersion])
  @@index([projectId, status])
  @@index([projectId, priority])
  @@index([projectId, category])
}

model ContentBrief {
  id                String   @id @default(uuid()) @db.Uuid
  projectId         String   @db.Uuid
  contentDocumentId String?  @db.Uuid
  aiTaskId          String   @unique @db.Uuid
  promptVersion     String
  factSnapshotHash  String
  briefJson         Json
  sourceReferences  Json
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  document ContentDocument? @relation(fields: [contentDocumentId], references: [id], onDelete: Cascade)
  keywordContentBriefRequests KeywordContentBriefRequest[]

  @@index([projectId, createdAt])
  @@index([contentDocumentId, createdAt])
}

model ContentQualityRun {
  id                    String                  @id @default(uuid()) @db.Uuid
  projectId             String                  @db.Uuid
  rulesetVersion        Int
  status                ContentQualityRunStatus @default(QUEUED)
  inputSnapshotCutoffAt DateTime?
  inputDocumentCount    Int                     @default(0)
  findingCount          Int                     @default(0)
  startedAt             DateTime?
  completedAt           DateTime?
  errorCode             String?
  requestedByActorId    String?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  project  Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  findings ContentQualityFinding[] @relation("ContentQualityFindingLatestRun")

  @@index([projectId, status])
  @@index([projectId, createdAt])
}

model ContentQualityFinding {
  id                            String                      @id @default(uuid()) @db.Uuid
  projectId                     String                      @db.Uuid
  contentDocumentId             String                      @db.Uuid
  latestRunId                   String?                     @db.Uuid
  findingKey                    String
  ruleVersion                   Int
  category                      ContentQualityCategory
  priority                      ContentPriority
  status                        ContentQualityFindingStatus @default(OPEN)
  summary                       String
  evidence                      Json
  firstDetectedAt               DateTime
  lastDetectedAt                DateTime
  acceptedPublicationProposalId String?                     @unique @db.Uuid
  createdAt                     DateTime                    @default(now())
  updatedAt                     DateTime                    @updatedAt

  project                     Project                    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  document                    ContentDocument            @relation(fields: [contentDocumentId], references: [id], onDelete: Cascade)
  latestRun                   ContentQualityRun?         @relation("ContentQualityFindingLatestRun", fields: [latestRunId], references: [id], onDelete: SetNull)
  acceptedPublicationProposal PublicationProposal?       @relation("ContentQualityFindingAcceptedProposal", fields: [acceptedPublicationProposalId], references: [id], onDelete: SetNull)
  history                     ContentQualityFindingHistory[]

  @@unique([contentDocumentId, findingKey, ruleVersion])
  @@index([projectId, status])
  @@index([projectId, category])
  @@index([projectId, priority])
}

model ContentQualityFindingHistory {
  id         String                      @id @default(uuid()) @db.Uuid
  findingId  String                      @db.Uuid
  fromStatus ContentQualityFindingStatus
  toStatus   ContentQualityFindingStatus
  actorId    String
  reason     String?
  metadata   Json
  createdAt  DateTime                    @default(now())

  finding ContentQualityFinding @relation(fields: [findingId], references: [id], onDelete: Cascade)

  @@index([findingId, createdAt])
}
