generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum PlanLevel {
  STANDARD
  ADVANCED
  ENTERPRISE
}

enum CrawlRunStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum CrawlRunType {
  FULL
  INCREMENTAL
  MANUAL
  SCHEDULED
  SINGLE_PAGE
}

enum FetchMethod {
  HTTP
  BROWSER
}

enum SitemapType {
  INDEX
  URLSET
}

enum SeoAuditRunStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum SeoSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum SeoRuleOutcome {
  PASS
  FAIL
  UNKNOWN
  NOT_APPLICABLE
}

enum SeoIssueStatus {
  OPEN
  IN_PROGRESS
  PARTIALLY_FIXED
  RESOLVED
  IGNORED
  REGRESSED
}

enum SeoIssueComparison {
  NEW
  PERSISTENT
  REGRESSED
}

enum GeoAuditRunStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum GeoDimension {
  CITABILITY
  ENTITY
  BRAND
  AI_CRAWLER
  CONTENT_GEO
}

enum GeoPriority {
  HIGH
  MEDIUM
  LOW
}

enum GeoRuleOutcome {
  PASS
  FAIL
  UNKNOWN
}

enum EntityType {
  ORGANIZATION
  PERSON
  PRODUCT
  SERVICE
  PLACE
  TOPIC
  OTHER
}

enum EntityStatus {
  ACTIVE
  ARCHIVED
}

enum EntityObservationSource {
  SCHEMA
  HTML_META
  OPEN_GRAPH
  TITLE
  HEADING
  INTERNAL_LINK
  PROJECT_CONFIG
}

enum PageEntityRole {
  PRIMARY
  MENTIONED
  AUTHOR
  PUBLISHER
  ABOUT
}

enum AiCrawlerReadinessStatus {
  PASS
  FAIL
  UNKNOWN
}

model Project {
  id              String        @id @default(uuid()) @db.Uuid
  name            String
  slug            String        @unique
  primaryDomain   String
  industry        String?
  defaultLanguage String        @default("zh-CN")
  targetCountry   String        @default("CN")
  timezone        String        @default("Asia/Shanghai")
  status          ProjectStatus @default(ACTIVE)
  planLevel       PlanLevel     @default(STANDARD)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  crawlRuns                 CrawlRun[]
  pages                     Page[]
  seoAuditRuns              SeoAuditRun[]
  seoIssues                 SeoIssue[]
  seoScores                 SeoScore[]
  geoAuditRuns              GeoAuditRun[]
  entities                  Entity[]
  entityRelations           EntityRelation[]
  geoScores                 GeoScore[]
  markets                   ProjectMarket[]
  memberships               ProjectMembership[]
  keywords                  Keyword[]
  keywordRelations          KeywordRelation[]
  keywordGroups             KeywordGroup[]
  keywordGroupMemberships   KeywordGroupMembership[]
  keywordSuggestions        KeywordSuggestion[]
  keywordAuditEvents        KeywordAuditEvent[]
  keywordOpportunitySnapshots KeywordOpportunitySnapshot[]

  @@index([primaryDomain])
  @@index([status])
}

model CrawlRun {
  id              String         @id @default(uuid()) @db.Uuid
  projectId       String         @db.Uuid
  runType         CrawlRunType
  status          CrawlRunStatus @default(QUEUED)
  seedUrl         String
  maxPages        Int            @default(500)
  pagesDiscovered Int            @default(0)
  pagesCrawled    Int            @default(0)
  pagesSucceeded  Int            @default(0)
  pagesFailed     Int            @default(0)
  startedAt       DateTime?
  finishedAt      DateTime?
  errorMessage    String?
  crawlerVersion  String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  snapshots      PageSnapshot[]
  robotsResults  RobotsResult[]
  sitemapSources SitemapSource[]
  seoAuditRuns   SeoAuditRun[]
  geoAuditRuns   GeoAuditRun[]

  @@index([projectId, createdAt])
  @@index([projectId, status])
}

model Page {
  id            String   @id @default(uuid()) @db.Uuid
  projectId     String   @db.Uuid
  url           String
  normalizedUrl String
  host          String
  path          String
  pageType      String?
  firstSeenAt   DateTime @default(now())
  lastSeenAt    DateTime @default(now())
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project            Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  snapshots          PageSnapshot[]
  seoRuleResults     SeoRuleResult[]
  seoIssuePages      SeoIssuePage[]
  geoRuleResults     GeoRuleResult[]
  citabilityResults  CitabilityResult[]
  entityObservations EntityObservation[]
  pageEntities       PageEntity[]
  entityRelations    EntityRelation[]

  @@unique([projectId, normalizedUrl])
  @@index([projectId, host])
  @@index([projectId, isActive])
}

model PageSnapshot {
  id                 String   @id @default(uuid()) @db.Uuid
  pageId             String   @db.Uuid
  crawlRunId         String   @db.Uuid
  finalUrl           String
  statusCode         Int?
  contentType        String?
  title              String?
  metaDescription    String?
  canonicalUrl       String?
  metaRobots         String?
  h1                 String?
  h1Count            Int      @default(0)
  h2Count            Int      @default(0)
  h3Count            Int      @default(0)
  wordCount          Int      @default(0)
  language           String?
  internalLinksCount Int      @default(0)
  externalLinksCount Int      @default(0)
  imagesCount        Int      @default(0)
  imagesWithoutAlt   Int      @default(0)
  schemaCount        Int      @default(0)
  htmlHash           String?
  contentHash        String?
  responseTimeMs     Int?
  htmlSizeBytes      Int?
  rendered           Boolean  @default(false)
  indexable          Boolean?
  capturedAt         DateTime @default(now())
  parserVersion      String

  page         Page         @relation(fields: [pageId], references: [id], onDelete: Cascade)
  crawlRun     CrawlRun     @relation(fields: [crawlRunId], references: [id], onDelete: Cascade)
  httpResult   HttpResult?
  renderResult RenderResult?

  @@index([pageId, capturedAt])
  @@index([crawlRunId])
  @@index([statusCode])
}

model HttpResult {
  id             String      @id @default(uuid()) @db.Uuid
  pageSnapshotId String      @unique @db.Uuid
  requestUrl     String
  finalUrl       String
  statusCode     Int?
  fetchMethod    FetchMethod @default(HTTP)
  redirectChain Json?
  headers        Json?
  responseBytes  Int?
  latencyMs      Int?
  fetchError     String?
  createdAt      DateTime    @default(now())

  pageSnapshot PageSnapshot @relation(fields: [pageSnapshotId], references: [id], onDelete: Cascade)
}

model RenderResult {
  id             String   @id @default(uuid()) @db.Uuid
  pageSnapshotId String   @unique @db.Uuid
  attempted      Boolean  @default(false)
  succeeded      Boolean  @default(false)
  reason         String?
  renderTimeMs   Int?
  browserVersion String?
  createdAt      DateTime @default(now())

  pageSnapshot PageSnapshot @relation(fields: [pageSnapshotId], references: [id], onDelete: Cascade)
}

model RobotsResult {
  id          String   @id @default(uuid()) @db.Uuid
  crawlRunId  String   @db.Uuid
  url         String
  statusCode  Int?
  contentHash String?
  rawText     String?
  fetchedAt   DateTime @default(now())
  parseError  String?

  crawlRun CrawlRun @relation(fields: [crawlRunId], references: [id], onDelete: Cascade)

  @@index([crawlRunId, fetchedAt])
}

model SitemapSource {
  id                 String       @id @default(uuid()) @db.Uuid
  crawlRunId         String       @db.Uuid
  url                String
  statusCode         Int?
  type               SitemapType?
  parseError         String?
  discoveredUrlCount Int          @default(0)
  fetchedAt          DateTime     @default(now())

  crawlRun CrawlRun     @relation(fields: [crawlRunId], references: [id], onDelete: Cascade)
  urls     SitemapUrl[]

  @@index([crawlRunId, fetchedAt])
}

model SitemapUrl {
  id              String   @id @default(uuid()) @db.Uuid
  sitemapSourceId String   @db.Uuid
  normalizedUrl   String
  lastmod         DateTime?
  changefreq      String?
  priority        Float?
  createdAt       DateTime @default(now())

  sitemapSource SitemapSource @relation(fields: [sitemapSourceId], references: [id], onDelete: Cascade)

  @@unique([sitemapSourceId, normalizedUrl])
  @@index([normalizedUrl])
}

model SeoAuditRun {
  id             String            @id @default(uuid()) @db.Uuid
  projectId      String            @db.Uuid
  crawlRunId     String            @db.Uuid
  status         SeoAuditRunStatus @default(QUEUED)
  startedAt      DateTime?
  finishedAt     DateTime?
  errorMessage   String?
  engineVersion  String
  eligiblePages  Int               @default(0)
  rulesEvaluated Int               @default(0)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  project          Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  crawlRun         CrawlRun             @relation(fields: [crawlRunId], references: [id], onDelete: Cascade)
  ruleResults      SeoRuleResult[]
  issueOccurrences SeoIssueOccurrence[]
  seoScore         SeoScore?

  @@unique([projectId, crawlRunId])
  @@index([projectId, createdAt])
  @@index([projectId, status])
}

model SeoRule {
  id          String   @id @default(uuid()) @db.Uuid
  ruleCode    String   @unique
  name        String
  category    String
  description String
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  versions SeoRuleVersion[]
  issues   SeoIssue[]
}

model SeoRuleVersion {
  id              String      @id @default(uuid()) @db.Uuid
  seoRuleId       String      @db.Uuid
  version         Int
  severity        SeoSeverity
  weight          Float
  detectionType   String
  detectionConfig Json?
  seoImpact       String
  fixGuide        String
  releasedAt      DateTime
  deprecatedAt    DateTime?

  seoRule          SeoRule              @relation(fields: [seoRuleId], references: [id], onDelete: Restrict)
  ruleResults      SeoRuleResult[]
  issueOccurrences SeoIssueOccurrence[]
  scoreComponents  SeoScoreComponent[]

  @@unique([seoRuleId, version])
  @@index([severity])
}

model SeoRuleResult {
  id            String         @id @default(uuid()) @db.Uuid
  auditRunId    String         @db.Uuid
  pageId        String?        @db.Uuid
  ruleVersionId String         @db.Uuid
  resultKey     String
  outcome       SeoRuleOutcome
  evidence      Json?
  createdAt     DateTime       @default(now())

  auditRun    SeoAuditRun    @relation(fields: [auditRunId], references: [id], onDelete: Cascade)
  page        Page?          @relation(fields: [pageId], references: [id], onDelete: Cascade)
  ruleVersion SeoRuleVersion @relation(fields: [ruleVersionId], references: [id], onDelete: Restrict)
  issuePages  SeoIssuePage[]

  @@unique([auditRunId, resultKey, ruleVersionId])
  @@index([auditRunId, outcome])
  @@index([pageId])
}

model SeoIssue {
  id              String         @id @default(uuid()) @db.Uuid
  projectId       String         @db.Uuid
  ruleId          String         @db.Uuid
  issueKey        String
  title           String
  category        String
  currentSeverity SeoSeverity
  status          SeoIssueStatus @default(OPEN)
  firstSeenAt     DateTime
  lastSeenAt      DateTime
  resolvedAt      DateTime?
  ignoredAt       DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  project     Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  rule        SeoRule              @relation(fields: [ruleId], references: [id], onDelete: Restrict)
  occurrences SeoIssueOccurrence[]

  @@unique([projectId, issueKey])
  @@index([projectId, status])
  @@index([projectId, currentSeverity])
}

model SeoIssueOccurrence {
  id                 String             @id @default(uuid()) @db.Uuid
  seoIssueId         String             @db.Uuid
  auditRunId         String             @db.Uuid
  ruleVersionId      String             @db.Uuid
  comparison         SeoIssueComparison
  severity           SeoSeverity
  affectedPagesCount Int
  evidenceSummary    Json?
  createdAt          DateTime           @default(now())

  seoIssue    SeoIssue        @relation(fields: [seoIssueId], references: [id], onDelete: Cascade)
  auditRun    SeoAuditRun     @relation(fields: [auditRunId], references: [id], onDelete: Cascade)
  ruleVersion SeoRuleVersion  @relation(fields: [ruleVersionId], references: [id], onDelete: Restrict)
  pages       SeoIssuePage[]

  @@unique([seoIssueId, auditRunId])
  @@index([auditRunId, comparison])
}

model SeoIssuePage {
  id                String @id @default(uuid()) @db.Uuid
  issueOccurrenceId String @db.Uuid
  pageId            String @db.Uuid
  ruleResultId      String @db.Uuid
  evidence          Json?

  issueOccurrence SeoIssueOccurrence @relation(fields: [issueOccurrenceId], references: [id], onDelete: Cascade)
  page            Page               @relation(fields: [pageId], references: [id], onDelete: Cascade)
  ruleResult      SeoRuleResult      @relation(fields: [ruleResultId], references: [id], onDelete: Cascade)

  @@unique([issueOccurrenceId, pageId])
  @@index([pageId])
}

model SeoScore {
  id            String   @id @default(uuid()) @db.Uuid
  auditRunId    String   @unique @db.Uuid
  projectId     String   @db.Uuid
  score         Float
  previousScore Float?
  change        Float?
  calculatedAt  DateTime @default(now())
  engineVersion String

  auditRun   SeoAuditRun         @relation(fields: [auditRunId], references: [id], onDelete: Cascade)
  project    Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  components SeoScoreComponent[]

  @@index([projectId, calculatedAt])
}

model SeoScoreComponent {
  id                 String  @id @default(uuid()) @db.Uuid
  seoScoreId         String  @db.Uuid
  componentCode      String
  componentName      String
  affectedPages      Int
  eligiblePages      Int
  pageImpactFactor   Float
  severityMultiplier Float
  weight             Float
  importanceFactor   Float   @default(1)
  penalty            Float
  ruleVersionId      String  @db.Uuid

  seoScore    SeoScore       @relation(fields: [seoScoreId], references: [id], onDelete: Cascade)
  ruleVersion SeoRuleVersion @relation(fields: [ruleVersionId], references: [id], onDelete: Restrict)

  @@unique([seoScoreId, ruleVersionId])
}

model GeoAuditRun {
  id             String            @id @default(uuid()) @db.Uuid
  projectId      String            @db.Uuid
  crawlRunId     String            @db.Uuid
  status         GeoAuditRunStatus @default(QUEUED)
  eligiblePages  Int               @default(0)
  rulesEvaluated Int               @default(0)
  engineVersion  String
  startedAt      DateTime?
  finishedAt     DateTime?
  errorMessage   String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  project              Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  crawlRun             CrawlRun                @relation(fields: [crawlRunId], references: [id], onDelete: Cascade)
  ruleResults          GeoRuleResult[]
  citabilityResults    CitabilityResult[]
  entityObservations   EntityObservation[]
  aiCrawlerResults     AiCrawlerResult[]
  brandAuthorityResult BrandAuthorityResult?
  geoScore             GeoScore?

  @@index([projectId, createdAt])
  @@index([projectId, status])
  @@index([crawlRunId])
}

model GeoRule {
  id          String   @id @default(uuid()) @db.Uuid
  ruleCode    String   @unique
  name        String
  category    String
  description String
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  versions GeoRuleVersion[]
}

model GeoRuleVersion {
  id              String       @id @default(uuid()) @db.Uuid
  geoRuleId       String       @db.Uuid
  version         Int
  dimension       GeoDimension
  severity        GeoPriority
  weight          Float
  detectionType   String
  detectionConfig Json?
  geoImpact       String
  fixGuide        String
  releasedAt      DateTime
  deprecatedAt    DateTime?

  geoRule     GeoRule         @relation(fields: [geoRuleId], references: [id], onDelete: Restrict)
  ruleResults GeoRuleResult[]

  @@unique([geoRuleId, version])
  @@index([dimension])
  @@index([severity])
}

model GeoRuleResult {
  id            String         @id @default(uuid()) @db.Uuid
  geoAuditRunId String         @db.Uuid
  pageId        String?        @db.Uuid
  entityId      String?        @db.Uuid
  ruleVersionId String         @db.Uuid
  resultKey     String
  outcome       GeoRuleOutcome
  evidence      Json?
  createdAt     DateTime       @default(now())

  geoAuditRun GeoAuditRun    @relation(fields: [geoAuditRunId], references: [id], onDelete: Cascade)
  page        Page?          @relation(fields: [pageId], references: [id], onDelete: SetNull)
  entity      Entity?        @relation(fields: [entityId], references: [id], onDelete: SetNull)
  ruleVersion GeoRuleVersion @relation(fields: [ruleVersionId], references: [id], onDelete: Restrict)

  @@unique([geoAuditRunId, ruleVersionId, resultKey])
  @@index([geoAuditRunId, outcome])
  @@index([pageId])
  @@index([entityId])
}

model CitabilityResult {
  id                     String   @id @default(uuid()) @db.Uuid
  geoAuditRunId          String   @db.Uuid
  pageId                 String   @db.Uuid
  answerFirstScore       Float?
  headingStructureScore  Float
  factualDensityScore    Float?
  sourceSupportScore     Float
  extractabilityScore    Float
  definitionClarityScore Float?
  overallScore           Float
  evidence               Json?
  engineVersion          String
  createdAt              DateTime @default(now())

  geoAuditRun GeoAuditRun @relation(fields: [geoAuditRunId], references: [id], onDelete: Cascade)
  page        Page        @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([geoAuditRunId, pageId])
  @@index([pageId, createdAt])
}

model Entity {
  id             String       @id @default(uuid()) @db.Uuid
  projectId      String       @db.Uuid
  entityType     EntityType
  canonicalName  String
  normalizedName String
  description    String?
  officialUrl    String?
  status         EntityStatus @default(ACTIVE)
  confidence     Float        @default(1)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  project         Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  aliases         EntityAlias[]
  observations    EntityObservation[]
  pageEntities    PageEntity[]
  sourceRelations EntityRelation[]     @relation("EntityRelationSource")
  targetRelations EntityRelation[]     @relation("EntityRelationTarget")
  geoRuleResults  GeoRuleResult[]

  @@unique([projectId, entityType, normalizedName])
  @@index([projectId, status])
  @@index([normalizedName])
}

model EntityAlias {
  id              String @id @default(uuid()) @db.Uuid
  entityId        String @db.Uuid
  alias           String
  normalizedAlias String
  sourceType      String

  entity Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@unique([entityId, normalizedAlias])
  @@index([normalizedAlias])
}

model EntityRelation {
  id             String   @id @default(uuid()) @db.Uuid
  projectId      String   @db.Uuid
  sourceEntityId String   @db.Uuid
  relationType   String
  targetEntityId String   @db.Uuid
  sourcePageId   String?  @db.Uuid
  confidence     Float    @default(1)
  evidence       Json?
  createdAt      DateTime @default(now())

  project      Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceEntity Entity  @relation("EntityRelationSource", fields: [sourceEntityId], references: [id], onDelete: Restrict)
  targetEntity Entity  @relation("EntityRelationTarget", fields: [targetEntityId], references: [id], onDelete: Restrict)
  sourcePage   Page?   @relation(fields: [sourcePageId], references: [id], onDelete: SetNull)

  @@index([projectId, relationType])
  @@index([sourceEntityId])
  @@index([targetEntityId])
}

model EntityObservation {
  id            String                  @id @default(uuid()) @db.Uuid
  geoAuditRunId String                  @db.Uuid
  entityId      String                  @db.Uuid
  pageId        String?                 @db.Uuid
  sourceType    EntityObservationSource
  property      String
  value         String
  evidence      Json?
  createdAt     DateTime                @default(now())

  geoAuditRun GeoAuditRun @relation(fields: [geoAuditRunId], references: [id], onDelete: Cascade)
  entity      Entity      @relation(fields: [entityId], references: [id], onDelete: Restrict)
  page        Page?       @relation(fields: [pageId], references: [id], onDelete: SetNull)

  @@index([geoAuditRunId, sourceType])
  @@index([entityId])
  @@index([pageId])
}

model PageEntity {
  pageId     String         @db.Uuid
  entityId   String         @db.Uuid
  role       PageEntityRole
  confidence Float          @default(1)
  sourceType String

  page   Page   @relation(fields: [pageId], references: [id], onDelete: Cascade)
  entity Entity @relation(fields: [entityId], references: [id], onDelete: Restrict)

  @@id([pageId, entityId, role, sourceType])
  @@index([entityId])
}

model AiCrawlerResult {
  id                String                   @id @default(uuid()) @db.Uuid
  geoAuditRunId     String                   @db.Uuid
  crawlerCode       String
  robotsAllowed     Boolean?
  metaRobotsAllowed Boolean?
  xRobotsAllowed    Boolean?
  reachable         Boolean?
  status            AiCrawlerReadinessStatus
  evidence          Json?
  createdAt         DateTime                 @default(now())

  geoAuditRun GeoAuditRun @relation(fields: [geoAuditRunId], references: [id], onDelete: Cascade)

  @@unique([geoAuditRunId, crawlerCode])
  @@index([crawlerCode, status])
}

model BrandAuthorityResult {
  id                         String   @id @default(uuid()) @db.Uuid
  geoAuditRunId              String   @unique @db.Uuid
  officialIdentityPresent    Boolean
  organizationSchemaPresent  Boolean
  sameAsCount                Int      @default(0)
  publisherConsistency       Float
  contactIdentityConsistency Float
  aboutPagePresent           Boolean
  overallScore               Float
  evidence                   Json?
  createdAt                  DateTime @default(now())

  geoAuditRun GeoAuditRun @relation(fields: [geoAuditRunId], references: [id], onDelete: Cascade)
}

model GeoScore {
  id             String   @id @default(uuid()) @db.Uuid
  geoAuditRunId  String   @unique @db.Uuid
  projectId      String   @db.Uuid
  scoreType      String
  score          Float
  previousScore  Float?
  change         Float?
  formulaVersion String
  calculatedAt   DateTime @default(now())
  engineVersion String

  geoAuditRun GeoAuditRun         @relation(fields: [geoAuditRunId], references: [id], onDelete: Cascade)
  project     Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  components  GeoScoreComponent[]

  @@index([projectId, calculatedAt])
  @@index([projectId, scoreType])
}

model GeoScoreComponent {
  id              String @id @default(uuid()) @db.Uuid
  geoScoreId      String @db.Uuid
  componentCode   String
  componentName   String
  rawScore        Float
  weight          Float
  weightedScore   Float
  sourceType      String
  sourceReference String?

  geoScore GeoScore @relation(fields: [geoScoreId], references: [id], onDelete: Cascade)

  @@unique([geoScoreId, componentCode])
}
